//kage:unit pixels

// one_slit.kage - a Kage arrangement of waves passing through a single slit.
//
// Original: cnzn0 "one-slit" https://github.com/cnzn0/one-slit (MIT License, Copyright (c) 2026 cnzn0)
// This file rebuilds the original scene (17 wave sources, a wall with one open slit, icy wave crests)
// in Kage. It is not a copy of the original code. The original copyright and license text are in
// NOTICE in this folder.
//
// Differences from the original (owner's decision):
//   - The original evolves the wave equation in time and bakes 120 frames. kagelife cannot pass the
//     previous frame to a shader, so this uses a stateless analytic approximation.
//   - Each source emits one circular Ricker wave (Mexican hat) every LoopPeriod seconds.
//   - Waves past the slit are summed from SlitSamples points across the opening, each treated as a
//     new source (Huygens). The opening width to wavelength ratio sets how widely they diffract.
//   - Reflection at the wall and the original's 12-sample ray-direction shadow are omitted.
//     The grain texture is replaced by a per-pixel hash.
//   - Source position, emit time and strength come from a fixed hash of the source index
//     (not Random, which changes every frame).
//
// Length unit is the "cell" (one grid cell of the original). The screen height is DomainHeight cells.
package main

var Time float
var Resolution vec2

// ---- Tunables ---------------------------------------------------------------
// Original values cite line numbers in cnzn0/one-slit docs/engine.js.

// Cells across the screen height. Original ny=250 (line 48).
const DomainHeight = 250.0

// Wall position (fraction of screen width). Original WX=205 / nx=750 (lines 48-49).
const WallXFrac = 0.2733

// Slit opening width (cells). Original GAP=[122,127], 6 cells (line 49).
const SlitWidth = 6.0

// Slit center (fraction of screen height). Original (122+127+1)/2=125 -> 125/250 (line 49).
const SlitCenterFrac = 0.5

// Wavelength (cells). Original LAM=11 (line 50). Smaller SlitWidth/Wavelength diffracts wider.
const Wavelength = 11.0

// Wave speed (cells/s). Original c=0.5 cell/step x SUB=4 x FPS=24 = 48 (line 48).
const WaveSpeed = 48.0

// Loop length (s). Original FRAMES=120 / FPS=24 = 5 s (line 48). Each source emits once per loop.
// Assumption: pulse folds elapsed time to the nearest emission, so it is correct only while the
// distance per loop WaveSpeed*LoopPeriod >= the pulse width 2*PulseCutoff*Wavelength
// (now 240 cells >= 46.2 cells). Below that, one of two overlapping pulses from adjacent loops vanishes.
const LoopPeriod = 5.0

// Number of sources. Original gaps array length 17 (line 54). Loop count, so keep it a constant.
const SourceCount = 17

// Huygens points across the slit opening. No aliasing (false fringes) while the spacing
// SlitWidth/SlitSamples < Wavelength/2. 8 points are safe up to a 44-cell opening.
const SlitSamples = 8

// Amplitude decay (1/cell). Amplitude is multiplied by exp(-Decay*distance). The original has no
// internal decay and only absorbs in the outer 26 cells (line 86), so 0 is closest. Raise to quiet far waves.
const Decay = 0.0

// Phase (in periods) where the Ricker wave is cut off. Original |d|<46 steps (line 91) = 46xF0 ~= 2.1 periods.
// Keep WaveSpeed*LoopPeriod >= 2*PulseCutoff*Wavelength (see LoopPeriod).
const PulseCutoff = 2.1

// Base amplitude of one source. The original finite-difference amplitude does not map to this
// approximation, so this was tuned against the original poster (docs/assets/poster.png); no original line.
// Higher gives more bright crests; lower gives darker, sparser ones.
const Amplitude = 0.45

// Display gain left of the wall (source side). Original gain=2.6 (line 87).
const LeftGain = 2.6

// Display gain right of the wall (past the slit), and the range (cells) where distance falloff is cancelled.
// Original gain=min(26, 7.5*sqrt(1+r/5)) (line 87) cancels falloff up to r~=55 cells, so use that distance.
const RightGain = 2.6
const RightFlatRange = 55.0

// Light direction (azimuth, elevation, radians). Original az=-.5, el=.3 (line 82).
const LightAzimuth = -0.5
const LightElevation = 0.3

// Wall line width. Original 1.5px (at 500px height, line 98).
const WallLineWidth = 1.5
const WallLineRefHeight = 500.0

// Colors live in Fragment (original FF lines 78-80, and #C6C7C1 on line 98).

// ---------------------------------------------------------------------------

const pi = 3.14159265

// hash is a pseudo-random value in 0..1, same formula as original engine.js line 29.
func hash(n float) float {
	return fract(sin(n*127.1+3.3) * 43758.5453)
}

// hash2 maps pixel coords to 0..1 (for grain; sin-free, stable at large coords).
func hash2(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

// ricker is the Ricker wave. s is phase in periods. Original ricker (line 45) rewritten by phase.
func ricker(s float) float {
	x := pi * s
	y := x * x
	return (1.0 - 2.0*y) * exp(-y)
}

// pulse is the displacement now at distance r (cells) from a source that emits at t0.
// Folding elapsed time to the nearest emission in the loop follows the original force (line 91).
func pulse(r, t0 float) float {
	period := WaveSpeed * LoopPeriod
	d := WaveSpeed*(Time-t0) - r
	d = mod(d+0.5*period, period) - 0.5*period
	s := d / Wavelength
	if abs(s) >= PulseCutoff {
		return 0.0
	}
	return ricker(s)
}

// spread is 2D cylindrical-wave falloff (rounded over one wavelength to avoid blowing up near the source) and decay.
func spread(r float) float {
	return Amplitude * exp(-Decay*r) / sqrt(1.0+r/Wavelength)
}

// sourcePos is the position (cells) of source i. Distribution follows original ARR (lines 54-55):
// x is biased by r^0.8 within the area before the wall; y excludes a 34-cell margin top and bottom.
func sourcePos(n, wallX float) vec2 {
	x := wallX * (40.0/205.0 + (135.0/205.0)*pow(hash(n*3.0+1.0), 0.8))
	y := 34.0 + (DomainHeight-68.0)*hash(n*3.0+2.0)
	return vec2(x, y)
}

// sourceTime is the emit time of source i (s, 0..LoopPeriod).
func sourceTime(n float) float {
	return hash(n*3.0+4.5) * LoopPeriod
}

// sourceWeight is the strength of source i. Same 3 levels as original line 55 (20% 1.7, 40% 1, rest 0.6).
func sourceWeight(n float) float {
	h := hash(n*3.0 + 3.0)
	if h < 0.2 {
		return 1.7
	}
	if h < 0.6 {
		return 1.0
	}
	return 0.6
}

// slitPoint is y (cells) of Huygens point j: the center of each of SlitSamples equal parts of the opening.
func slitPoint(j int, slitY float) float {
	return slitY + SlitWidth*((float(j)+0.5)/float(SlitSamples)-0.5)
}

// height is the water height at p (cells). Left of the wall: direct waves. Right: sum over Huygens points.
func height(p vec2, wallX, slitY float) float {
	z := 0.0
	if p.x < wallX {
		// Left: SourceCount iterations per pixel.
		for i := 0; i < SourceCount; i++ {
			n := float(i)
			r := length(p - sourcePos(n, wallX))
			z += sourceWeight(n) * pulse(r, sourceTime(n)) * spread(r)
		}
		return z * LeftGain
	}

	// Right: precompute distance and factor from each Huygens point to p (SlitSamples iterations).
	var r2 [SlitSamples]float
	var k2 [SlitSamples]float
	for j := 0; j < SlitSamples; j++ {
		d := p - vec2(wallX, slitPoint(j, slitY))
		r := length(d)
		r2[j] = r
		// Obliquity (1+cos(theta))/2 (weaker toward the side) x distance falloff (cancelled up to RightFlatRange).
		k2[j] = 0.5 * (1.0 + d.x/max(r, 1e-3)) * exp(-Decay*r) *
			sqrt((1.0+RightFlatRange/Wavelength)/(1.0+max(r, RightFlatRange)/Wavelength))
	}
	// SourceCount x SlitSamples iterations per pixel.
	for i := 0; i < SourceCount; i++ {
		n := float(i)
		sp := sourcePos(n, wallX)
		t0 := sourceTime(n)
		w := sourceWeight(n)
		for j := 0; j < SlitSamples; j++ {
			r1 := length(vec2(wallX, slitPoint(j, slitY)) - sp)
			z += w * pulse(r1+r2[j], t0) * spread(r1) * k2[j]
		}
	}
	// The Huygens sum integrates over the opening: average the points, times opening width
	// (normalized so the original 6 cells give 1x). A wider opening passes more and focuses forward.
	return z / float(SlitSamples) * (SlitWidth / 6.0) * RightGain
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	bgColor := vec3(0.0431, 0.0431, 0.0471)
	crestColor := vec3(0.46, 0.49, 0.64)
	catchColor := vec3(0.93, 0.94, 0.97)
	wallColor := vec3(0.776, 0.780, 0.757)

	pxPerCell := Resolution.y / DomainHeight
	p := dstPos.xy / pxPerCell
	domainW := Resolution.x / pxPerCell
	wallX := floor(domainW*WallXFrac) + 0.5
	slitY := DomainHeight * SlitCenterFrac

	// Soft-clip the height, as in original HF (line 57).
	z := height(p, wallX, slitY)
	z = z / (1.0 + abs(z)*0.22)

	// Normal from screen derivatives (original FF lines 64-65 use neighbor-cell differences).
	// Screen y points down, so flip the sign of y.
	// height switches formula at x=wallX (direct waves left, Huygens sum right), so height is discontinuous there.
	// If the wall crosses a 2x2 pixel quad, dfdx reads the step as slope and draws a dark line at the slit.
	// So zero the x slope only when the quad mixes left and right. Call dfdx outside branches.
	side := step(wallX, p.x)
	dzdx := dfdx(z) * pxPerCell * (1.0 - clamp(abs(dfdx(side)), 0.0, 1.0))
	dzdy := -dfdy(z) * pxPerCell
	n := normalize(vec3(-dzdx, -dzdy, 1.0))
	l := vec3(cos(LightAzimuth)*cos(LightElevation), sin(LightAzimuth)*cos(LightElevation), sin(LightElevation))
	r := max(0.0, dot(n, l)) / l.z
	up := max(0.0, r-1.0)
	dn := max(0.0, 1.0-r)

	// Grain: approximates the original grain texture (lines 16-18; normal noise, mean 128/255,
	// std dev 42/255) with the sum of 3 uniform randoms.
	q0 := dstPos.xy
	q1 := dstPos.xy*1.87 + 0.37
	g0 := hash2(q0) + hash2(q0+17.0) + hash2(q0+41.0)
	g1 := hash2(q1) + hash2(q1+23.0) + hash2(q1+59.0)
	tex0 := 0.502 + 0.165*(g0-1.5)/0.5
	tex1 := 0.502 + 0.165*(g1-1.5)/0.5
	t0 := mix(clamp((tex0-0.22)/0.56, 0.0, 1.0), clamp((tex1-0.22)/0.56, 0.0, 1.0), 0.4)
	cat := smoothstep(t0-0.06, t0+0.06, up*0.62) * smoothstep(0.02, 0.1, up)

	// Color (original FF lines 78-80).
	c := bgColor * (1.0 - 0.5*smoothstep(0.0, 1.0, dn))
	c += crestColor * 0.17 * smoothstep(0.0, 1.3, up)
	c = mix(c, catchColor, cat)

	// Wall line (left open at the slit).
	lineW := WallLineWidth * Resolution.y / WallLineRefHeight
	dx := abs(dstPos.x - wallX*pxPerCell)
	onLine := 1.0 - smoothstep(0.5*lineW-0.5, 0.5*lineW+0.5, dx)
	inGap := step(abs(p.y-slitY), 0.5*SlitWidth)
	c = mix(c, wallColor, onLine*(1.0-inGap))

	return vec4(c, 1.0)
}
