//kage:unit pixels

// 06_equalizer.kage - Equalizer. LED bars jump at the downbeat and fall toward the end of the beat.
//
// Design:
//   - The width is split into BarCount bars, each cut into LED segments. Green, yellow, red from the bottom.
//     Unlit segments stay faintly visible. A faint reflection sits below the floor on a charcoal background.
//     Just after the downbeat, a soft glow is added around lit segments.
//   - There is no audio input, so bar heights are synthetic.
//       1. Per-beat seed (beatSeed): kagelife passes only the beat phase Beat (0..1), not a beat number.
//          So the start time of the current beat is estimated as Time - Beat*BeatGuess, divided by BeatGuess, floored.
//          If the real beat length equals BeatGuess, this is constant within a beat and steps by 1 at each beat.
//          Limit: if the real beat length T differs from BeatGuess, the value drifts by (T/BeatGuess - 1) per beat,
//          so in about |T/BeatGuess - 1| of beats the seed changes once mid-beat and heights switch mid-beat
//          (with BeatGuess=0.5 s=120 BPM: ~6% of beats at 128 BPM, ~33% at 90 BPM).
//          Without tapping, kagelife runs Beat at its default BPM (DefaultBPM = 120 in internal/tempo/tapper.go),
//          which matches BeatGuess, so no mid-beat switches occur.
//       2. Downbeat height (peak): from bar index and seed. Coarse value noise every 4 bars (neighbors connect into
//          spectrum-like hills) plus fine per-bar variation. Higher on the left (bass), lower on the right.
//       3. Beat envelope: rest + (1-rest)*exp(-JumpDecay*Beat). Jumps to peak at the downbeat, falls toward the end.
//          rest is smaller on the left (bass), so bass bars jump more.
//       4. Wobble: a little smooth value noise over Time so bars never look frozen mid-beat.
//     A white peak marker sits above each bar. It starts at peak on the downbeat, falls with gravity-like
//     acceleration, and catches up with the bar.
//   - Brightness: no uniform full-screen flash. More segments light at the downbeat, so the average screen
//     brightness rises and falls once per beat. Per-frame Random is not used.
//
// Per-pixel loops: none (bar and segment indices come directly from the pixel).
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Number of bars.
const BarCount = 32.0

// LED segments per max bar height.
const SegmentCount = 24.0

// Floor height (fraction from the bottom) and max bar height (fraction of screen height).
const FloorY = 0.17
const MaxHeight = 0.74

// Assumed beat length for the seed (s). 0.5 = 120 BPM.
const BeatGuess = 0.5

// Fraction of height left at the end of the beat: left (bass) and right (treble).
const RestBass = 0.18
const RestTreble = 0.5

// Fall rate after the downbeat.
const JumpDecay = 3.2

// Wobble size (fraction of max height) and rate (grid cells per second).
const Wobble = 0.07
const WobbleRate = 6.0

// Peak marker fall rate (per beat phase squared, fraction of max height).
const CapFall = 1.6

// Brightness of unlit and lit segments.
const UnlitLevel = 0.06
const LitLevel = 0.85

// Downbeat glow strength and its decay rate.
const GlowLevel = 0.35
const GlowDecay = 7.0

// ---------------------------------------------------------------------------

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

// beatSeed increases by 1 per beat (estimate; limits are in the header).
func beatSeed() float {
	return floor((Time - Beat*BeatGuess) / BeatGuess)
}

// peakHeight is the downbeat height of bar (0..1). Constant while seed is unchanged.
func peakHeight(bar, seed float) float {
	// Coarse value noise every 4 bars (connects with neighbors).
	g := bar / 4.0
	gi := floor(g)
	gf := fract(g)
	gu := gf * gf * (3.0 - 2.0*gf)
	coarse := mix(hash21(vec2(gi, seed)), hash21(vec2(gi+1.0, seed)), gu)
	fine := hash21(vec2(bar+57.0, seed*1.37))
	n := 0.7*coarse + 0.3*fine
	// Higher on the left (bass). Left-side peaks can reach the red segments.
	tilt := 1.12 - 0.45*bar/BarCount
	return clamp((0.25+0.85*n)*tilt, 0.12, 1.0)
}

// wobble is a smooth -1..1 wobble over Time.
func wobble(bar float) float {
	t := Time*WobbleRate + bar*0.61
	i := floor(t)
	f := fract(t)
	u := f * f * (3.0 - 2.0*f)
	return mix(hash21(vec2(bar, i)), hash21(vec2(bar, i+1.0)), u)*2.0 - 1.0
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	x01 := dstPos.x / Resolution.x
	y01 := 1.0 - dstPos.y/Resolution.y // bottom = 0

	bg := mix(vec3(0.045, 0.045, 0.055), vec3(0.015, 0.015, 0.02), y01)
	c := bg

	// Small side margins.
	xm := (x01 - 0.04) / 0.92
	if xm < 0.0 || xm >= 1.0 {
		return vec4(c, 1.0)
	}
	bar := floor(xm * BarCount)
	local := fract(xm * BarCount)
	inBar := step(0.14, local) * step(local, 0.86)

	seed := beatSeed()
	pk := peakHeight(bar, seed)
	treble := bar / (BarCount - 1.0)
	rest := mix(RestBass, RestTreble, treble)
	env := exp(-JumpDecay * Beat)
	h := clamp(pk*(rest+(1.0-rest)*env)+Wobble*wobble(bar)*(0.4+0.6*treble), 0.03, 1.0)

	// Peak marker: starts falling from peak at the downbeat, catches up with the bar.
	capH := max(pk-CapFall*Beat*Beat, h)

	// Above the floor: y is 0 (floor) .. 1 (max height). Below the floor, flip as a reflection.
	mirrored := 0.0
	y := (y01 - FloorY) / MaxHeight
	if y < 0.0 {
		mirrored = 1.0
		y = -y * 1.6
	}

	seg := floor(y * SegmentCount)
	segLocal := fract(y * SegmentCount)
	inSeg := step(0.2, segLocal)
	level := (seg + 0.5) / SegmentCount
	inRange := step(y, 1.0)

	ledCol := mix(vec3(0.1, 1.0, 0.3), vec3(1.0, 0.85, 0.1), smoothstep(0.45, 0.65, level))
	ledCol = mix(ledCol, vec3(1.0, 0.15, 0.1), smoothstep(0.78, 0.9, level))

	// A segment lights if its center is below the bar height.
	lit := step(level, h)
	led := ledCol * mix(UnlitLevel, LitLevel, lit) * inSeg * inBar * inRange

	// Peak marker (segment containing capH). Not drawn over lit segments.
	capSeg := min(floor(capH*SegmentCount), SegmentCount-1.0)
	capMark := (1.0 - step(0.5, abs(seg-capSeg))) * inSeg * inBar * (1.0 - lit) * inRange
	led += vec3(0.92, 0.92, 1.0) * capMark * 0.85

	// Downbeat glow: soft light around the lit range, by distance from the bar center.
	dx := abs(local - 0.5)
	glow := GlowLevel * exp(-GlowDecay*Beat) * exp(-dx*dx*18.0) * step(y, h+0.03) * inRange
	led += ledCol * glow * 0.5

	if mirrored > 0.5 {
		led *= 0.22 * exp(-y*3.0)
	}
	c += led

	return vec4(c, 1.0)
}
