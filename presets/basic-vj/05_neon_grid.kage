//kage:unit pixels

// 05_neon_grid.kage - Neon grid. Synthwave perspective floor and a sun setting behind mountains.
//
// Design:
//   - Lower half: perspective floor. A square grid of magenta vertical and cyan horizontal lines flows
//     toward the viewer; distance fades into fog. Near the horizon, where line spacing approaches a pixel,
//     lines are replaced by their average intensity to avoid moire.
//   - Above the horizon: a yellow-to-pink gradient sun with horizontal cuts in its lower half that drift down.
//     Dark purple mountains (sum of sines, magenta-lit ridge) in front of the sun. Sky goes indigo to
//     red-violet near the horizon, with small stars twinkling up high (from a Time hash; per-frame Random is not used).
//   - A faint vertical band on the floor reflects the sun.
//   - Beat (downbeat = 0) drives three things. Each rises at the downbeat and decays within the beat,
//     so one brightness peak per beat.
//       1. Grid lines glow: brightness x (LineBase + LineFlash*exp(-FlashDecay*Beat)). Only thin lines glow.
//       2. Light wave: a band runs from near to the horizon at the downbeat, brightening grid lines on its path
//          (surfaces are not filled).
//       3. Floor advance: Time*Speed + Surge*(e(Beat) - Beat) (e(b) = 1-(1-b)^3). Lunges at the downbeat;
//          no position jump across beats. The sun halo also pulses slightly.
//
// Per-pixel loops: none (0).
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Horizon height (screen center = 0, up = +, screen height = 1).
const Horizon = -0.06

// Camera height (smaller = flatter floor).
const CamHeight = 0.32

// Grid density (lines per floor unit; same both ways, square cells).
const GridDensity = 2.5

// Fog density (larger = far lines vanish sooner).
const FogDensity = 0.09

// Floor speed and downbeat surge (keep Speed > 3*Surge so motion never reverses at 180 BPM).
const Speed = 0.9
const Surge = 0.25

// Grid line brightness: constant, downbeat boost, decay rate.
const LineBase = 0.5
const LineFlash = 1.1
const FlashDecay = 5.0

// Light wave strength, width (floor depth units), and reach within one beat.
const WaveGain = 1.6
const WaveWidth = 0.5
const WaveReach = 14.0

// Sun center height, radius, and halo pulse on the beat.
const SunY = 0.16
const SunRadius = 0.24
const HaloPulse = 0.5

// Mountain height (above the horizon).
const MountainHeight = 0.075

// Star amount (0..1, larger = more).
const StarAmount = 0.06

// ---------------------------------------------------------------------------

// gridLine is the intensity of lines at integer x. Width ~1.5 px via screen derivatives.
// Where spacing approaches a pixel (large fw), fade to the average intensity to avoid moire.
func gridLine(x float) float {
	fw := abs(dfdx(x)) + abs(dfdy(x))
	d := abs(fract(x+0.5) - 0.5)
	w := fw*1.5 + 1e-4
	l := 1.0 - smoothstep(0.0, w, d)
	return mix(l, min(w, 1.0)*0.5, smoothstep(0.15, 0.45, fw))
}

func hash21(p vec2) float {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

// mountain is the mountain height (above the horizon) at x.
func mountain(x float) float {
	m := 0.55*abs(sin(x*2.1+0.4)) + 0.3*abs(sin(x*5.3+1.7)) + 0.15*abs(sin(x*13.0+2.9))
	// Lower directly under the sun so its cuts stay visible.
	valley := 0.35 + 0.65*smoothstep(0.1, 0.45, abs(x))
	return MountainHeight * m * valley
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y

	b := clamp(Beat, 0.0, 1.0)
	e := 1.0 - (1.0-b)*(1.0-b)*(1.0-b)
	travel := Time*Speed + Surge*(e-b)
	env := exp(-FlashDecay * b)

	// Floor coordinates are computed outside the branch (no dfdx inside branches). Unused above the horizon.
	dy := max(Horizon-uv.y, 1e-3)
	zf := CamHeight / dy
	xw := uv.x * zf
	zw := zf + travel
	lx := gridLine(xw * GridDensity)
	lz := gridLine(zw * GridDensity)
	fog := exp(-zf * FogDensity)

	var c vec3
	if uv.y < Horizon {
		// Light wave: leaves the near side (zf~=1) at the downbeat, reaches WaveReach by the end of the beat.
		wz := 1.0 + WaveReach*e
		wave := exp(-(zf-wz)*(zf-wz)/(WaveWidth*WaveWidth*(1.0+e*4.0))) * (1.0 - b) * (1.0 - b)
		lineGain := (LineBase + LineFlash*env + WaveGain*wave) * fog

		floorCol := mix(vec3(0.03, 0.0, 0.06), vec3(0.10, 0.0, 0.13), fog)
		c = floorCol
		c += vec3(1.0, 0.15, 0.75) * lx * lineGain
		c += vec3(0.15, 0.85, 1.0) * lz * lineGain
		// Sun reflection (faint central vertical band, stronger near the horizon).
		refl := exp(-uv.x*uv.x*40.0) * exp(-dy*6.0)
		c += vec3(1.0, 0.35, 0.45) * refl * 0.22
		// Haze near the horizon.
		c += vec3(0.6, 0.1, 0.45) * exp(-dy*30.0) * 0.5
	} else {
		h := uv.y - Horizon
		sky := mix(vec3(0.55, 0.08, 0.38), vec3(0.03, 0.01, 0.11), smoothstep(0.0, 0.5, h))
		c = sky

		// Stars: one per cell, more likely higher up. Twinkle from Time.
		cell := floor(dstPos.xy / 6.0)
		sr := hash21(cell)
		if sr < StarAmount*smoothstep(0.15, 0.4, h) {
			sp := fract(dstPos.xy/6.0) - 0.5
			tw := 0.6 + 0.4*sin(Time*(1.5+sr*30.0)+sr*100.0)
			c += vec3(0.9, 0.85, 1.0) * (1.0 - smoothstep(0.0, 0.35, length(sp))) * tw * 0.8
		}

		// Sun.
		sp := uv - vec2(0.0, SunY)
		rs := length(sp)
		sunT := clamp((sp.y+SunRadius)/(2.0*SunRadius), 0.0, 1.0) // 0 = bottom, 1 = top
		sunCol := mix(vec3(1.0, 0.15, 0.55), vec3(1.0, 0.9, 0.3), sunT)
		disk := 1.0 - smoothstep(SunRadius-0.002, SunRadius+0.002, rs)
		// Cuts in the lower half: thicker lower down, drifting slowly downward.
		if sp.y < 0.0 {
			k := -sp.y / SunRadius // 0..1
			band := fract(sp.y*16.0 + Time*0.4)
			cut := smoothstep(k*0.6-0.03, k*0.6, band) // cut where band < k*0.6
			disk *= cut
		}
		c = mix(c, sunCol, disk)
		// Halo, slightly stronger at the downbeat.
		halo := exp(-max(rs-SunRadius, 0.0)*8.0) * (1.0 - disk)
		c += vec3(1.0, 0.3, 0.5) * halo * (0.16 + 0.1*HaloPulse*env)

		// Mountains in front of sun and sky, with a magenta-lit ridge.
		mh := mountain(uv.x)
		if h < mh {
			c = mix(vec3(0.07, 0.01, 0.12), vec3(0.16, 0.02, 0.2), h/max(mh, 1e-3))
		}
		c += vec3(1.0, 0.25, 0.8) * exp(-abs(h-mh)*Resolution.y*0.35) * 0.7

		// Horizon line.
		c += vec3(1.0, 0.4, 0.8) * exp(-h*120.0) * 0.6
	}

	return vec4(c, 1.0)
}
