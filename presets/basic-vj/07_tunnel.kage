//kage:unit pixels

// 07_tunnel.kage - Tunnel. Orange hexagonal rings surge forward each beat; a white ring flies in from
// the depth at the downbeat.
//
// Design:
//   - Hexagonal tunnel with depth toward the screen center. A point at radius r has depth z = TunnelRadius/r;
//     glowing rings sit every RingSpacing in z. Depth fades to black in fog; a red glow sits at the vanishing point.
//   - Molten-metal palette: near rings gold-white, middle orange, far crimson. Inner walls: dark red-brown
//     checker and corner streaks. Uses only red to orange, to stay apart from the other 8 presets
//     (mostly green/blue/purple/pink). Ring color depends only on depth.
//   - The vanishing point sways slowly, more with depth, so the tunnel looks winding. Rings twist with depth.
//   - Beat (three effects; none use a beat number, so nothing jumps across beats):
//     1. Rings sit where z/RingSpacing + e(Beat) is an integer (e(b) = 1-(1-b)^3). e goes 0 -> 1 per beat,
//        so every ring moves exactly one spacing forward per beat. When e wraps 1 -> 0 the pattern is just
//        shifted by one spacing, i.e. identical. e is fast at the downbeat, so rings surge then stop.
//     2. A white ring (pulse) is born at depth PulseFar at the downbeat and flies to the front over one beat.
//        The previous pulse has fully faded at the front before the swap, so at the beat boundary only a small
//        ring is born in the far fog.
//     3. At the downbeat, rings brighten and fog thins (a brief view deep in). Both decay by exp(-FlashDecay*Beat).
//        Brightness rises once per beat. Only rings and the depth glow, so the screen never blows out to white.
//
// Per-pixel loops: none (0).
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Tunnel radius (fraction of screen height).
const TunnelRadius = 0.3

// Ring spacing (depth units).
const RingSpacing = 0.6

// Ring width (fraction of spacing).
const RingWidth = 0.07

// Number of polygon sides.
const Sides = 6.0

// Twist with depth (rad/depth) and overall spin speed (rad/s).
const Twist = 0.12
const Spin = 0.15

// Vanishing point sway size (fraction of screen height) and speed (rad/s).
const SwayAmount = 0.12
const SwaySpeed = 0.31

// Fog density (larger = darker sooner with depth) and downbeat thinning fraction.
const Fog = 0.24
const FogLift = 0.4

// Depth where near rings start fading, and where they are gone (Start > End). Near rings cover a large
// screen area, so they fade before leaving the screen to limit full-screen brightness swings.
const NearFadeStart = 0.7
const NearFadeEnd = 0.3

// Downbeat ring brightness boost and its decay rate.
const RingFlash = 0.9
const FlashDecay = 5.0

// Pulse (white ring flying in at the downbeat): birth depth, width (fraction of spacing), brightness.
const PulseFar = 7.0
const PulseWidth = 0.09
const PulseGain = 1.3

// Vanishing point red glow: falloff (larger = smaller) and brightness.
const CoreSize = 18.0
const CoreGain = 0.35

// ---------------------------------------------------------------------------

const pi = 3.14159265

// palette is the ring color at depth z: near gold-white -> orange -> far crimson.
func palette(z float) vec3 {
	gold := vec3(1.0, 0.86, 0.55)
	orange := vec3(1.0, 0.42, 0.06)
	crimson := vec3(0.75, 0.04, 0.1)
	c := mix(gold, orange, smoothstep(0.4, 2.0, z))
	return mix(c, crimson, smoothstep(2.0, 6.0, z))
}

// band returns 0..1 for whether d (distance from the spacing center) is inside a band of width w.
// Far rings get thin and dense, so the width is floored by the screen-space width fw, and brightness is
// reduced by the widening to suppress aliasing flicker.
func band(d, w, fw float) float {
	ww := max(w, fw*1.2)
	return (1.0 - smoothstep(ww*0.5, ww, d)) * (w / ww)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y

	b := Beat
	e := 1.0 - (1.0-b)*(1.0-b)*(1.0-b)
	env := exp(-FlashDecay * b)

	// Vanishing point sway. Estimate depth z0 without sway, then shift the center more with depth (near barely moves).
	sway := SwayAmount * vec2(sin(Time*SwaySpeed), sin(Time*SwaySpeed*1.37+1.0)*0.6)
	z0 := TunnelRadius / max(length(uv), 1e-4)
	p := uv - sway*(1.0-exp(-z0*0.35))

	r := max(length(p), 1e-4)
	a := atan2(p.y, p.x)

	// Twist, then hexagonal radius. 2*pi is a multiple of sector, so the atan2 seam does not show.
	ang := a + (TunnelRadius/r)*Twist + Time*Spin
	sector := 2.0 * pi / Sides
	m := mod(ang, sector) - 0.5*sector
	z := TunnelRadius / max(r*cos(m), 1e-4)

	fog := exp(-z * Fog * (1.0 - FogLift*env))
	near := smoothstep(NearFadeEnd, NearFadeStart, z)

	// 1. Ring positions.
	s := z/RingSpacing + e
	d := abs(fract(s+0.5) - 0.5)
	fw := abs(dfdx(s)) + abs(dfdy(s))
	ring := band(d, RingWidth, fw)
	glow := exp(-d*22.0) * 0.3

	// 2. Pulse. Depth zp goes PulseFar -> 0 over one beat. Faint right after birth (fog and fade-in).
	zp := PulseFar * (1.0 - b)
	sp := abs(z-zp) / RingSpacing
	pulse := band(sp, PulseWidth, fw) + exp(-sp*10.0)*0.35
	pulse *= smoothstep(0.0, 0.06, b) * PulseGain

	// Inner walls: corner streaks and a checker flowing into the depth.
	edge := abs(m) / (0.5 * sector) // 0 = side center, 1 = corner
	corner := smoothstep(0.92, 1.0, edge)
	cu := floor(ang/sector*2.0+0.5*Sides) + floor(z*2.0+Time*1.5)
	checker := mod(cu, 2.0)

	col := palette(z)

	c := vec3(0.025, 0.004, 0.01)
	c += vec3(0.2, 0.05, 0.03) * checker * 0.3 * fog
	c += col * corner * 0.3 * fog
	c += col * (ring + glow) * (0.7 + RingFlash*env) * fog * near
	c += vec3(1.0, 0.95, 0.85) * pulse * fog * near

	// 3. Red glow at the vanishing point (slightly stronger at the downbeat).
	c += vec3(0.9, 0.12, 0.05) * exp(-r*r*CoreSize*CoreSize) * CoreGain * (1.0 + 0.6*env)

	return vec4(c, 1.0)
}
