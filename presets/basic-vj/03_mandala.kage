//kage:unit pixels

// 03_mandala.kage - Kaleidoscope mandala. A line-art pattern turns one step per beat; a light ring
// runs outward from each downbeat.
//
// Design:
//   - Angle is split into Segments and mirror-folded (kaleidoscope). Each folded segment draws petal circles,
//     a flower ring (chain of overlapping circles), radial lines, diagonal chords and dots in thin lines.
//     Three radial layers so the pattern reaches the screen corners.
//   - Layers rotate in alternating directions (inner +, middle -, outer +). Concentric circles hide the seams.
//   - Colors: gold (inner) -> platinum (middle) -> aqua (outer) lines on deep indigo-teal, faint center glow.
//   - Beat (depends only on the in-beat phase; bars are not counted):
//       1. Rotation: one segment (2*pi/Segments) per beat. That angle equals the Segments-fold symmetry period,
//          so stepping back one segment when Beat wraps 1 -> 0 does not change the image.
//          Progress is 1-(1-Beat)^4: fast at the downbeat, then stops (a "click" step).
//       2. Light ring: born at the center on the downbeat, reaches the corners by Beat = 1. Lines it crosses brighten.
//       3. Line glow and zoom: lines brighten and zoom in slightly at the downbeat (decays by exp(-GlowDecay*Beat)).
//     One brightness peak per beat. Only lines and the ring glow; the background brightness does not change with Beat.
//   - Random and Frame are not used (no per-frame flicker).
//
// Per-pixel loops: RingCount (7). Otherwise a fixed number of lines.
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Number of segments (symmetry order).
const Segments = 12.0

// Number of concentric circles (loop count), from RingStart every RingGap.
const RingCount = 7

// First circle radius and circle spacing (radius in screen heights).
const RingStart = 0.06
const RingGap = 0.13

// Layer boundaries (radius in screen heights). inner < InnerRadius <= middle < OuterRadius <= outer.
// Both sit on circle radii (RingStart + RingGap*k) to hide the seams.
const InnerRadius = 0.19
const OuterRadius = 0.45

// Line width (px).
const LineWidthPx = 1.6

// Slow constant rotation independent of the beat (rad/s).
const SlowSpin = 0.04

// Downbeat line glow boost and its decay rate.
const GlowBoost = 0.8
const GlowDecay = 5.0

// Downbeat zoom-in (0.03 = 3%).
const PunchZoom = 0.03

// Light ring brightness, how much it brightens lines it crosses, and its width (radius).
const WaveGain = 0.9
const WaveLift = 1.4
const WaveWidth = 0.04

// Period of the slow gold/aqua balance drift (s).
const HueDrift = 23.0

// ---------------------------------------------------------------------------

const pi = 3.14159265

// fold rotates uv by rot, then folds it into one kaleidoscope segment.
// The segment center line lies on the x axis (y is 0..r*sin(pi/Segments)).
func fold(uv vec2, rot float) vec2 {
	seg := 2.0 * pi / Segments
	r := length(uv)
	a := atan2(uv.y, uv.x) + rot
	a = mod(a, seg)
	a = abs(a - 0.5*seg)
	return r * vec2(cos(a), sin(a))
}

// line is the line intensity at distance d (core + glow).
func line(d, w float) float {
	return 1.0 - smoothstep(0.0, w, d) + 0.25*exp(-d/(w*5.0))
}

// circle is a circle outline with center c and radius rad.
func circle(q, c vec2, rad, w float) float {
	return line(abs(length(q-c)-rad), w)
}

// band is 1 when radius r is within lo..hi (smooth edges).
func band(r, lo, hi float) float {
	return smoothstep(lo-0.004, lo+0.004, r) * (1.0 - smoothstep(hi-0.004, hi+0.004, r))
}

// innerLayer is the inner layer (r < InnerRadius). Gold flower.
func innerLayer(q vec2, r, w float) float {
	ink := 0.0
	// Double petal circles.
	ink += circle(q, vec2(0.11, 0.0), 0.055, w)
	ink += circle(q, vec2(0.11, 0.0), 0.022, w) * 0.7
	// Segment center line.
	ink += line(abs(q.y), w) * 0.5 * band(r, 0.02, InnerRadius)
	// Center dot.
	ink += line(max(r-0.012, 0.0), w)
	return ink
}

// midLayer is the middle layer (InnerRadius <= r < OuterRadius). Flower ring and star chords.
func midLayer(q vec2, r, w float) float {
	ink := 0.0
	// Flower ring: circles centered on radius 0.32, radius > half the center spacing so neighbors overlap.
	d := 0.32
	ink += circle(q, vec2(d, 0.0), d*sin(pi/Segments)*1.35, w)
	// Small petal circle.
	ink += circle(q, vec2(0.24, 0.0), 0.028, w) * 0.8
	// Diagonal chord (forms a star across segments).
	n := normalize(vec2(sin(0.55), -cos(0.55)))
	ink += line(abs(dot(q-vec2(0.30, 0.0), n)), w) * 0.8
	// Dot on the segment boundary (fold line).
	ink += line(max(length(q-0.40*vec2(cos(pi/Segments), sin(pi/Segments)))-0.007, 0.0), w)
	return ink
}

// outerLayer is the outer layer (r >= OuterRadius). Radial lines to the corners and large petals.
func outerLayer(q vec2, r, w float) float {
	ink := 0.0
	// Large petal (pointed arch): mirrored, two arcs meet on the segment center line.
	ink += circle(q, vec2(0.52, -0.13), 0.21, w) * band(r, OuterRadius, 0.78)
	// Small circle inside the petal (clear of the petal tip).
	ink += circle(q, vec2(0.57, 0.0), 0.03, w) * 0.8
	// Radial lines (segment center line and boundary).
	ink += line(abs(q.y), w) * 0.55 * band(r, 0.72, 2.0)
	s := sin(pi / Segments)
	c := cos(pi / Segments)
	ink += line(abs(q.x*s-q.y*c), w) * 0.35 * band(r, OuterRadius, 2.0)
	// Far dot.
	ink += line(max(length(q-vec2(0.86, 0.0))-0.01, 0.0), w)
	return ink
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y
	w := LineWidthPx / Resolution.y

	b := fract(Beat)
	seg := 2.0 * pi / Segments
	turn := 1.0 - pow(1.0-b, 4.0)
	env := exp(-GlowDecay * b)

	// Slight zoom-in at the downbeat.
	uv *= 1.0 - PunchZoom*env
	r := length(uv)

	// Rotate and fold per layer. Inner and outer +, middle -. Each beat step is one segment.
	ink := 0.0
	if r < InnerRadius {
		ink = innerLayer(fold(uv, Time*SlowSpin+seg*turn), r, w)
	} else if r < OuterRadius {
		ink = midLayer(fold(uv, -Time*SlowSpin*1.3-seg*turn), r, w)
	} else {
		ink = outerLayer(fold(uv, Time*SlowSpin*0.6+seg*turn), r, w)
	}

	// Concentric circles (not rotating). Also hide the layer seams.
	for k := 0; k < RingCount; k++ {
		rk := RingStart + RingGap*float(k)
		ink += line(abs(r-rk), w) * 0.6
	}

	// Light ring: leaves the center at the downbeat, reaches the corners (radius ~1.05) at the end of the beat.
	rw := 0.03 + 1.02*(1.0-pow(1.0-b, 2.0))
	fade := pow(1.0-b, 1.5)
	near := exp(-abs(r-rw) / WaveWidth)
	wave := line(abs(r-rw), w*1.8) * fade

	ink = clamp(ink, 0.0, 1.8) * (1.0 + WaveLift*near*fade)

	// Color: gold inside, platinum middle, aqua outside. The balance drifts slowly.
	drift := 0.05 * sin(2.0*pi*Time/HueDrift)
	gold := vec3(1.0, 0.72, 0.28)
	pale := vec3(1.0, 0.93, 0.78)
	aqua := vec3(0.3, 0.92, 0.95)
	lc := mix(gold, pale, smoothstep(0.12+drift, 0.3+drift, r))
	lc = mix(lc, aqua, smoothstep(0.38+drift, 0.62+drift, r))

	// Background: deep indigo-teal. The center glow does not change with Beat.
	bg := mix(vec3(0.03, 0.08, 0.12), vec3(0.0, 0.012, 0.025), smoothstep(0.0, 0.9, r))
	bg += vec3(0.12, 0.07, 0.02) * exp(-r*r/0.012)

	col := bg + lc*ink*(0.5+GlowBoost*0.5*env)
	// Light ring leans platinum.
	col += mix(lc, pale, 0.5) * wave * WaveGain

	return vec4(col, 1.0)
}
