//kage:unit pixels

// 03_mandala.kage — 万華鏡マンダラ。線画の幾何学模様が拍ごとに一段ずつ回る。
//
// 設計:
//   - 角度を Segments 等分して鏡で折り返す（万華鏡）。折り返した 1 区画の中に、同心円・花弁の円・放射線・
//     斜めの弦を細い線で描く。内側と外側の 2 層は逆向きに回る。
//   - 色は深い青緑の地に金と水色の線。
//   - Beat: 拍ごとに 1 区画ぶん（2π/Segments）回る。回転角は Segments 回対称の周期と同じなので、
//     拍の変わり目（Beat が 1 から 0 に戻る所）で角度が 1 区画戻っても絵は変わらない。小節の頭を数えずに
//     「拍ごとに一段進む」動きになる。進み方は 1-(1-Beat)^4 で、拍頭で素早く回って止まる。
//     線の明るさも拍頭で上がる（exp(-GlowDecay*Beat)）。
//
// 1 画素あたりのループ: RingCount 回（5 回）。
package main

var Time float
var Beat float
var Resolution vec2

// ---- 調整用の値 ------------------------------------------------------------

// 区画の数（対称の次数）。
const Segments = 12.0

// 同心円の数（ループの回数）。
const RingCount = 5

// 線の太さ（画素）。
const LineWidthPx = 1.6

// 拍とは別に常にかかるゆっくりした回転（ラジアン/秒）。
const SlowSpin = 0.05

// 拍頭の線の明るさの増分と、それが引く速さ。
const GlowBoost = 0.9
const GlowDecay = 5.0

// 内側と外側の層の境目（画面の高さに対する半径）。
const SplitRadius = 0.25

// ---------------------------------------------------------------------------

const pi = 3.14159265

// fold は点 uv を角度 rot だけ回してから万華鏡の 1 区画に折り返した座標を返す。
func fold(uv vec2, rot float) vec2 {
	seg := 2.0 * pi / Segments
	r := length(uv)
	a := atan2(uv.y, uv.x) + rot
	a = mod(a, seg)
	a = abs(a - 0.5*seg)
	return r * vec2(cos(a), sin(a))
}

// line は距離 d の所の線の濃さ（芯 + にじみ）。
func line(d, w float) float {
	return 1.0 - smoothstep(0.0, w, d) + 0.25*exp(-d/(w*5.0))
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y
	w := LineWidthPx / Resolution.y

	seg := 2.0 * pi / Segments
	turn := 1.0 - pow(1.0-Beat, 4.0)
	env := exp(-GlowDecay * Beat)

	// 拍頭でほんの少し寄る。
	uv *= 1.0 - 0.02*env

	r := length(uv)
	inner := fold(uv, Time*SlowSpin+seg*turn)
	outer := fold(uv, -Time*SlowSpin*0.7-seg*turn)
	q := outer
	if r < SplitRadius {
		q = inner
	}

	ink := 0.0
	// 同心円。
	for k := 0; k < RingCount; k++ {
		rk := 0.06 + 0.095*float(k)
		ink += line(abs(r-rk), w) * 0.7
	}
	// 花弁の円（内側と外側で大きさを変える）。
	ink += line(abs(length(q-vec2(0.16, 0.0))-0.07), w)
	ink += line(abs(length(q-vec2(0.36, 0.0))-0.1), w)
	ink += line(abs(length(q-vec2(0.36, 0.0))-0.04), w)
	// 放射線（区画の中心線）。
	if r > 0.06 && r < 0.46 {
		ink += line(abs(q.y), w) * 0.6
	}
	// 斜めの弦（区画をまたいで星形になる）。
	n := normalize(vec2(sin(0.55), -cos(0.55)))
	ink += line(abs(dot(q-vec2(0.27, 0.0), n)), w) * 0.8 * step1(r, 0.46)
	// 小さな点。
	ink += line(max(length(q-vec2(0.455, 0.03))-0.006, 0.0), w)

	ink = clamp(ink, 0.0, 1.6)

	gold := vec3(1.0, 0.76, 0.32)
	aqua := vec3(0.35, 0.95, 0.9)
	lc := mix(gold, aqua, smoothstep(0.15, 0.4, r))
	bg := mix(vec3(0.02, 0.09, 0.1), vec3(0.0, 0.02, 0.03), smoothstep(0.0, 0.8, r))
	c := bg + lc*ink*(0.55+GlowBoost*0.5*env)

	return vec4(c, 1.0)
}

// step1 は r が rmax より内側なら 1、外なら 0。
func step1(r, rmax float) float {
	return 1.0 - smoothstep(rmax-0.005, rmax+0.005, r)
}
