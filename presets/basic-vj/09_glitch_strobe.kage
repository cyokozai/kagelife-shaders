//kage:unit pixels

// 09_glitch_strobe.kage - Glitch strobe. The most intense look, for drops.
//
// Design:
//   - Base: white line art on black: rounded-square rings expanding from the center, horizontally scrolling
//     data bands, and a center cross.
//   - Glitches on top:
//       * Row glitch: shift horizontal bands sideways; shifted bands are coarsely quantized in x (broken pixels).
//       * Block glitch: shift square blocks, tint lines acid yellow-green (AcidR/G/B), fill with dark yellow-green.
//       * Chromatic aberration: shift red and blue in opposite directions (red and cyan fringes on white lines).
//       * Scanlines: darken one row every ScanlinePx pixels.
//   - Palette: black, white, acid yellow-green (AcidR/G/B), plus red and cyan from chromatic aberration.
//   - Beat: at the downbeat (Beat=0), (1) aberration width, (2) glitch rate, (3) row shift, (4) ring zoom,
//     (5) white flash rise, then decay by exp(-k*Beat). The second half of the beat is nearly calm line art,
//     so the downbeat breakup stands out.
//
// Flash safety (owner's decision; apply strictly):
//   - The only full-screen brightening is the white flash FlashAmount*exp(-FlashDecay*Beat). It happens only
//     once per Beat cycle (the downbeat): 3 times/s at 180 BPM.
//     Note: Uniforms have no BPM, so the shader cannot keep it under 3 times/s above 180 BPM.
//     Instead, the amplitude is kept below the threshold below so it does not count as a flash.
//   - Amplitude: FlashAmount is set so the max-min of full-screen average relative luminance within one beat
//     stays under 0.1 (WCAG 2.x defines a flash as a relative luminance change of 10% or more).
//     See the PR for the measured values.
//   - No saturated-red flashing (the flash is white; red appears only on thin aberration fringes).
//   - Random (changes every frame) is used only for a small jitter of the row-glitch x shift. Shifting moves
//     the image sideways with almost no brightness change, so it causes no per-frame full-screen brightness change.
//   - Glitch locations come from Time quantized at GlitchRate per second (not Random).
//     Block fill is dark (BlockFill); no black/white inversion, since inverting changes brightness by the whole area at once.
//
// Per-pixel loops: none (0). The base function is called 3 times for chromatic aberration.
package main

var Time float
var Beat float
var Random float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Downbeat white flash strength and decay rate. Raising the strength crosses the flash threshold; re-measure if raised.
const FlashAmount = 0.22
const FlashDecay = 12.0

// Chromatic aberration width (fraction of screen height): constant and downbeat boost. Kept below the line width
// (~0.03 of height) so line cores stay white (wider splits lines into R/G/B stripes across the whole screen).
const ChromaBase = 0.002
const ChromaKick = 0.009

// Glitch rate: constant, downbeat boost, decay rate.
const GlitchBase = 0.03
const GlitchKick = 0.32
const GlitchDecay = 6.0

// Row shift (fraction of screen height): constant and downbeat boost.
const ShiftBase = 0.06
const ShiftKick = 0.3

// Glitch location changes per second.
const GlitchRate = 10.0

// Row glitch band height (px), x quantization of shifted bands (px), block size (px).
const RowHeightPx = 18.0
const RowPixelPx = 10.0
const BlockPx = 72.0

// Block glitch line color (AcidR/G/B) and block fill brightness (multiplies the acid color).
const AcidR = 0.78
const AcidG = 1.0
const AcidB = 0.05

const BlockFill = 0.07

// Scanline spacing (px) and brightness of darkened rows.
const ScanlinePx = 3.0
const ScanlineDim = 0.72

// ---------------------------------------------------------------------------

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

// base is the base brightness (0..1). uv: centered, screen height = 1. punch: 1 at the downbeat, decays to 0 within the beat.
func base(uv vec2, punch float) float {
	// Rounded-square rings expanding from the center. Slight zoom-in at the downbeat.
	q := abs(uv) * (1.0 + 0.12*punch)
	d := max(q.x, q.y) + 0.045*length(q)
	rings := fract(d*5.0 - Time*0.6)
	v := (1.0 - smoothstep(0.0, 0.03, abs(rings-0.5)-0.06)) * 0.85

	// Horizontally scrolling data bands, with per-band direction and speed.
	row := floor(uv.y * 22.0)
	if hash21(vec2(row, 3.0)) > 0.72 {
		xs := uv.x*10.0 + Time*(1.0+3.0*hash21(vec2(row, 9.0)))*sign(hash21(vec2(row, 5.0))-0.5)
		dash := step(0.55, hash21(vec2(floor(xs), row)))
		v = max(v, dash*0.45*step(0.3, fract(uv.y*22.0)))
	}

	// Center cross.
	arm := min(abs(uv.x), abs(uv.y))
	v = max(v, (1.0-smoothstep(0.004, 0.008, arm))*step(max(abs(uv.x), abs(uv.y)), 0.09))

	return v
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	p := dstPos.xy
	env := exp(-GlitchDecay * Beat)
	flash := FlashAmount * exp(-FlashDecay*Beat)
	punch := exp(-8.0 * Beat)
	seed := floor(Time * GlitchRate)
	amount := GlitchBase + GlitchKick*env

	q := p

	// Row glitch: shift each band sideways and quantize coarsely in x.
	row := floor(p.y / RowHeightPx)
	if hash21(vec2(row, seed)) < amount {
		off := (hash21(vec2(row, seed+0.5)) - 0.5) * (ShiftBase + ShiftKick*env) * Resolution.y
		off += (Random - 0.5) * 0.02 * Resolution.y
		q.x = floor((q.x+off)/RowPixelPx)*RowPixelPx + 0.5*RowPixelPx
	}

	// Block glitch: shift and tint acid yellow-green.
	blk := floor(p / BlockPx)
	tint := 0.0
	acid := vec3(AcidR, AcidG, AcidB)
	if hash21(blk+vec2(seed*1.37, seed*0.71)) < amount*0.35 {
		q.x += (hash21(blk+vec2(seed*2.11, 7.0)) - 0.5) * 0.5 * BlockPx
		tint = 1.0
	}

	uv := (q - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y
	ch := vec2(ChromaBase+ChromaKick*env, 0.0)
	r := base(uv+ch, punch)
	g := base(uv, punch)
	b := base(uv-ch, punch)
	c := vec3(r, g, b) * vec3(0.92, 0.96, 1.0)
	if tint > 0.5 {
		c = acid * max(max(r, g), b)
		c = max(c, acid*BlockFill)
	}

	// Scanlines. dstPos is the pixel center (n+0.5), so floor gives the row index.
	if mod(floor(p.y), ScanlinePx) < 1.0 {
		c *= ScanlineDim
	}

	// Downbeat white flash (once per beat). The only place full-screen brightness changes.
	c = mix(c, vec3(1.0), flash)

	return vec4(c, 1.0)
}
