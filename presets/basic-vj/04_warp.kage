//kage:unit pixels

// 04_warp.kage - Warp. Fly forward through stars, lunging ahead on each downbeat. For build-ups.
//
// Design:
//   - Stars live in 3D: distance rho from the travel axis and depth Z, shown at rho/Z from the screen center.
//     Nearer stars (small Z) stream outward faster, thicker and brighter. Stars that pass the near plane
//     respawn far away at a new position.
//   - The screen is cut by angle into LayerCount layers x SectorCount sectors, one star per sector.
//     A pixel checks only the star in its own sector, so one test per layer. Sector angles are offset
//     per layer to hide seams.
//   - Stars trail in depth: the trail is the segment Z..Z+trail, i.e. a radial streak toward the center.
//     For the same trail, nearer stars get longer streaks (perspective motion blur).
//     Head is white, tail root is blue-violet.
//   - Beat (pump = (1-Beat)^2, 1 at the downbeat):
//       Distance traveled pos = Time*CruiseSpeed + SurgeAmount*(e(Beat) - Beat), e(b) = 1-(1-b)^3.
//       e(b) - b is 0 at both Beat=0 and 1, so star positions do not jump across beats.
//       Fast at the downbeat, slow later in the beat.
//       Trail length (TrailSurge), core glow (CoreGlowSurge) and FOV zoom (FovPunch) are boosted by pump.
//       Trails and FOV change together at the downbeat for the "lunge"; brightness changes once per beat
//       (no full-screen flashing).
//   - Per-frame Random is not used (no full-screen flicker). Bars are not counted.
//
// Per-pixel loops: LayerCount (20). Pixels far from a star exit the layer after 1-3 hashes,
// skipping the remaining hashes and 2 exp calls. Early exits:
//   - inside the tail root (adds nothing; image unchanged)
//   - farther than cutK*wd from the star head/tail (adds < GlowCut per color channel; the faint outer glow is cut there)
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------
// Colors are at the top of Fragment (global vars become uniforms in Kage).

// Number of star layers (loop count). Stars on screen ~= LayerCount*SectorCount.
const LayerCount = 20

// Sectors per layer. More = more, finer stars.
const SectorCount = 36.0

// Constant forward speed (far-to-near = 1, per second).
const CruiseSpeed = 0.28

// Downbeat surge. Speed is CruiseSpeed + 2*SurgeAmount/beat at the downbeat, CruiseSpeed - SurgeAmount/beat at the end.
// Keep CruiseSpeed > 3*SurgeAmount so motion never reverses even at 180 BPM (beat = 1/3 s). Now 0.28 > 0.24.
const SurgeAmount = 0.08

// Star depth range (apparent distance). Stars leave the screen at ZNear and are a center dot at ZFar.
// Keep RhoMin/ZNear above half the screen diagonal (~1.0) so respawns are never visible. Now 2.5.
const ZNear = 0.06
const ZFar = 3.5

// Range of star distance rho from the travel axis.
const RhoMin = 0.15
const RhoMax = 1.1

// Trail length (in depth Z). TrailBase while cruising, plus TrailSurge at the downbeat.
const TrailBase = 0.07
const TrailSurge = 0.55

// Star width (fraction of screen height at Z=1). Grows as 1/Z when near, capped at StarWidthMax.
const StarWidth = 0.0024
const StarWidthMax = 0.008

// Overall star brightness multiplier.
const StarGain = 1.5

// Center glow (haze of far stars) and its downbeat boost.
const CoreGlow = 0.16
const CoreGlowSurge = 0.12

// Downbeat FOV zoom (fraction of screen size). Zooms in at the downbeat, returns within the beat.
const FovPunch = 0.035

// Overall roll speed (rad/s).
const RollSpeed = 0.04

// Brightness below which the faint outer glow is cut (per layer, per color channel, 0..1).
// About 1/8 of one 8-bit step (1/255). Larger = cheaper, but trims the glow around stars.
const GlowCut = 0.0005

// ---------------------------------------------------------------------------

const tau = 6.2831853

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// Colors: head (near-white cyan), tail root (blue-violet), occasional warm star, center glow, background (navy).
	headColor := vec3(0.92, 0.97, 1.0)
	tailColor := vec3(0.35, 0.22, 1.0)
	warmColor := vec3(1.0, 0.75, 0.45)
	coreColor := vec3(0.30, 0.45, 1.0)
	bgColor := vec3(0.004, 0.006, 0.025)

	// Centered coordinates, screen height = 1.
	px := 1.0 / Resolution.y
	uv := (dstPos.xy - 0.5*Resolution) * px
	uv.y = -uv.y

	b := clamp(Beat, 0.0, 1.0)
	pump := (1.0 - b) * (1.0 - b)
	e := 1.0 - (1.0-b)*(1.0-b)*(1.0-b)
	pos := Time*CruiseSpeed + SurgeAmount*(e-b)

	// Downbeat zoom (shrinking uv pushes stars outward) and slow roll.
	uv *= 1.0 - FovPunch*pump*(1.0-b)
	ca := cos(Time * RollSpeed)
	sa := sin(Time * RollSpeed)
	uv = vec2(ca*uv.x-sa*uv.y, sa*uv.x+ca*uv.y)

	r := length(uv) + 1e-5
	a := atan2(uv.y, uv.x)
	trail := TrailBase + TrailSurge*pump

	// Cutoff distance factor. One layer adds (line+glow)*along*bright*col per color channel;
	// along, fade, w/wd and col channels are <= 1, bright <= StarGain. For dist >= 2*wd, line <= 0.25*glow, so
	// added <= 1.25*0.12*StarGain*exp(-dist/(4*wd)). That is below GlowCut when dist > cutK*wd.
	cutK := max(4.0*log(0.15*StarGain/GlowCut), 2.0)

	c := vec3(0.0)
	for i := 0; i < LayerCount; i++ {
		fi := float(i)
		// Offset sector angles per layer.
		sf := fract(a/tau+hash21(vec2(fi, 1.7))) * SectorCount
		s := floor(sf)
		key := vec2(s, fi*7.13)

		// Offset depth phase per star so stars in one layer do not arrive as a ring.
		u := hash21(key) - pos
		z := fract(u)   // 0 = near, 1 = far
		Z := ZNear + z*(ZFar-ZNear)
		// Pixels inside the tail root (r < rt) get nothing from this layer (along below is 0).
		// rho >= RhoMin, so rt >= RhoMin/(Z+trail). Inside that, skip the rest of this layer (image unchanged).
		if r < RhoMin/(Z+trail) {
			continue
		}
		w := min(StarWidth/Z, StarWidthMax)
		wd := max(w, 0.8*px) // lines thinner than 1 px are widened and dimmed
		// Pixels farther than dmax from the star head/tail add < GlowCut from this layer; skip (see cutK above).
		// The head is at rho/Z <= RhoMax/Z; beyond that, dist >= r - RhoMax/Z.
		dmax := cutK * wd
		if r > RhoMax/Z+dmax {
			continue
		}

		gen := floor(u) // changes on each respawn (a respawned star is a new star)
		k2 := key + gen*vec2(13.17, 3.71)
		ha := hash21(k2 + 0.5)
		// Star angle within the sector (not too close to the edge, so it rarely spills into neighbors).
		da := (sf - s - (0.2 + 0.6*ha)) * (tau / SectorCount)
		dperp := r * abs(da) // perpendicular distance from the streak (lower bound of dist)
		if dperp > dmax {
			continue
		}

		hr := hash21(k2 + 9.1)
		rho := RhoMin + (RhoMax-RhoMin)*hr
		rt := rho / (Z + trail) // screen radius of the tail root
		if r < rt {
			continue
		}
		rh := rho / Z // screen radius of the head
		// Round cap beyond the head; the trail darkens toward the root.
		dr := max(r-rh, 0.0)
		dist := length(vec2(dr, dperp))
		if dist > dmax {
			continue
		}
		t := clamp((rh-r)/max(rh-rt, 1e-5), 0.0, 1.0)
		along := (1.0 - t) * (1.0 - t)
		hc := hash21(k2 + 4.3)
		line := exp(-(dist*dist)/(wd*wd)) * (w / wd)
		glow := 0.12 * exp(-dist/(4.0*wd)) * (w / wd)

		// Fade in far, fade out near (hide respawns). Nearer = brighter.
		fade := (1.0 - smoothstep(0.8, 1.0, z)) * smoothstep(0.0, 0.1, z)
		bright := StarGain * fade * (0.45 + 0.55/(1.0+2.0*Z))

		col := mix(headColor, tailColor, t)
		col = mix(col, warmColor, step(0.92, hc)*0.7)
		c += col * (line + glow) * along * bright
	}

	// Center glow (haze of far stars), slightly stronger at the downbeat.
	c += coreColor * exp(-r*4.0) * (CoreGlow + CoreGlowSurge*pump)
	c += bgColor

	return vec4(c, 1.0)
}
