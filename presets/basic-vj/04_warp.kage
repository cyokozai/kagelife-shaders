//kage:unit pixels

// 04_warp.kage — ワープ。星の中を手前へ飛ぶ。拍頭ごとにぐっと前へ突っ込む。ビルドアップ用。
//
// 設計:
//   - 星は 3 次元に置く。進む軸からの距離 ρ と奥行き Z を持ち、画面上では中心から ρ/Z の所に見える。
//     手前（Z が小さい）ほど外へ速く流れ、太く明るくなる。手前を過ぎた星は、別の位置で奥に戻る。
//   - 画面を中心からの角度で LayerCount 枚の層 × SectorCount 本の扇に切り、1 本の扇に星を 1 つ置く。
//     画素は自分の角度が入る扇の星だけを調べるので、1 層 1 回で済む。層ごとに扇の向きをずらし、継ぎ目を隠す。
//   - 星は奥行き方向に尾を引く。尾は「少し前の位置」= 奥行き Z〜Z+trail の線分で、画面では中心向きの
//     放射状の筋になる。同じ trail でも手前の星ほど筋が長い（遠近の動きぼけ）。尾は頭が白、根元が青紫。
//   - Beat（pump = (1-Beat)^2、拍頭で 1）:
//       進んだ距離 pos = Time*CruiseSpeed + SurgeAmount*(e(Beat) - Beat)、e(b) = 1-(1-b)^3。
//       e(b) - b は Beat=0 と 1 でどちらも 0 なので、拍の変わり目で星の位置は飛ばない。拍頭で速く、拍の後半は遅い。
//       尾の長さ（TrailSurge）・中心の光（CoreGlowSurge）・画角の寄り（FovPunch）を pump で拍頭に強める。
//       拍頭で尾と画角が一度に変わるのが「突っ込む」手応えで、明るさの変化は拍に 1 回だけ（全画面の明滅はしない）。
//   - 毎フレーム変わる Random は使わない（全画面のちらつきを作らない）。小節は数えない。
//
// 1 画素あたりのループ: LayerCount 回（20 回）。ただし星から遠い画素は、その層をハッシュ 1〜3 回で打ち切り、
// 残りのハッシュと exp 2 回を飛ばす。打ち切るのは次の 2 つ。
//   - 尾の根元より内側（何も足さない所。絵は変わらない）
//   - 星の頭・尾からの距離が cutK*wd より遠い所（足す量が色の成分ごとに GlowCut 未満。外側の淡い光をそこで切る）
package main

var Time float
var Beat float
var Resolution vec2

// ---- 調整用の値 ------------------------------------------------------------
// 色は Fragment の先頭にまとめてある（Kage では大域の var が uniform になるため）。

// 星の層の数（ループの回数）。画面の星の数はおよそ LayerCount*SectorCount。
const LayerCount = 20

// 1 層を角度で切る扇の数。多いほど星が細かく増える。
const SectorCount = 36.0

// 常に進む速さ（奥から手前までを 1 として、1 秒あたり）。
const CruiseSpeed = 0.28

// 拍頭の加速の量。速さは拍頭で CruiseSpeed + 2*SurgeAmount/拍の長さ、拍の終わりで CruiseSpeed - SurgeAmount/拍の長さ。
// 180 BPM（拍の長さ 1/3 秒）でも後ろへ戻らないよう CruiseSpeed > 3*SurgeAmount を保つ（いまは 0.28 > 0.24）。
const SurgeAmount = 0.08

// 星の奥行きの範囲（見かけの距離）。ZNear で画面の外へ抜け、ZFar で中心の点になる。
// 星が奥へ戻る瞬間が見えないよう RhoMin/ZNear を画面の対角の半分（約 1.0）より大きく保つ（いまは 2.5）。
const ZNear = 0.06
const ZFar = 3.5

// 進む軸からの星の距離 ρ の範囲。
const RhoMin = 0.15
const RhoMax = 1.1

// 尾の長さ（奥行き Z の単位）。巡航時の TrailBase に、拍頭で TrailSurge が足される。
const TrailBase = 0.07
const TrailSurge = 0.55

// 星の太さ（Z=1 での画面の高さに対する割合）。手前ほど 1/Z で太くなり、StarWidthMax で頭打ち。
const StarWidth = 0.0024
const StarWidthMax = 0.008

// 星全体の明るさの倍率。
const StarGain = 1.5

// 中心の光（奥の星のかすみ）と、拍頭の強まり。
const CoreGlow = 0.16
const CoreGlowSurge = 0.12

// 拍頭の画角の寄り（画面の大きさに対する割合）。拍頭で寄って、拍の中で戻る。
const FovPunch = 0.035

// 全体の回転の速さ（ラジアン/秒）。
const RollSpeed = 0.04

// 外側の淡い光を打ち切る明るさ（1 層・色の成分ごと, 0〜1）。8 bit の 1 段（1/255）の約 1/8。
// 大きいほど軽くなるが、星の周りのにじみが削れる。
const GlowCut = 0.0005

// ---------------------------------------------------------------------------

const tau = 6.2831853

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// 色。頭（白に近い水色）、尾の根元（青紫）、ときどき混ぜる暖色の星、中心の光、背景（濃紺）。
	headColor := vec3(0.92, 0.97, 1.0)
	tailColor := vec3(0.35, 0.22, 1.0)
	warmColor := vec3(1.0, 0.75, 0.45)
	coreColor := vec3(0.30, 0.45, 1.0)
	bgColor := vec3(0.004, 0.006, 0.025)

	// 画面の高さを 1 とした、中心が原点の座標。
	px := 1.0 / Resolution.y
	uv := (dstPos.xy - 0.5*Resolution) * px
	uv.y = -uv.y

	b := clamp(Beat, 0.0, 1.0)
	pump := (1.0 - b) * (1.0 - b)
	e := 1.0 - (1.0-b)*(1.0-b)*(1.0-b)
	pos := Time*CruiseSpeed + SurgeAmount*(e-b)

	// 拍頭の寄り（uv を縮めると、星が外へ押し出されて見える）と、ゆっくりした回転。
	uv *= 1.0 - FovPunch*pump*(1.0-b)
	ca := cos(Time * RollSpeed)
	sa := sin(Time * RollSpeed)
	uv = vec2(ca*uv.x-sa*uv.y, sa*uv.x+ca*uv.y)

	r := length(uv) + 1e-5
	a := atan2(uv.y, uv.x)
	trail := TrailBase + TrailSurge*pump

	// 打ち切りの距離の係数。1 層が色の成分ごとに足す量は (line+glow)*along*bright*col で、
	// along・fade・w/wd・col の成分は 1 以下、bright は StarGain 以下。dist >= 2*wd では line <= 0.25*glow なので、
	// 足す量 <= 1.25*0.12*StarGain*exp(-dist/(4*wd))。これが GlowCut 未満になるのは dist > cutK*wd のとき。
	cutK := max(4.0*log(0.15*StarGain/GlowCut), 2.0)

	c := vec3(0.0)
	for i := 0; i < LayerCount; i++ {
		fi := float(i)
		// 層ごとに扇の向きをずらす。
		sf := fract(a/tau+hash21(vec2(fi, 1.7))) * SectorCount
		s := floor(sf)
		key := vec2(s, fi*7.13)

		// 星ごとに奥行きの位相をずらし、同じ層の星が輪になって来ないようにする。
		u := hash21(key) - pos
		z := fract(u)   // 0 が手前、1 が奥
		Z := ZNear + z*(ZFar-ZNear)
		// 尾の根元より内側（r < rt）の画素には、この層の星は何も足さない（下の along が 0 になる）。
		// rho >= RhoMin なので rt >= RhoMin/(Z+trail)。これより内側なら、この層の残りを飛ばす（絵は変わらない）。
		if r < RhoMin/(Z+trail) {
			continue
		}
		w := min(StarWidth/Z, StarWidthMax)
		wd := max(w, 0.8*px) // 1 画素より細い線は、幅を広げて明るさを落とす
		// 星の頭・尾から dmax より遠い画素は、この層の足す量が GlowCut 未満なので飛ばす（下の cutK の説明）。
		// 頭は rho/Z <= RhoMax/Z の所にあり、それより外では dist >= r - RhoMax/Z。
		dmax := cutK * wd
		if r > RhoMax/Z+dmax {
			continue
		}

		gen := floor(u) // 奥へ戻るたびに変わる番号（戻ったら別の星にする）
		k2 := key + gen*vec2(13.17, 3.71)
		ha := hash21(k2 + 0.5)
		// 扇の中での星の角度（端に寄せすぎず、隣の扇へはみ出しにくくする）。
		da := (sf - s - (0.2 + 0.6*ha)) * (tau / SectorCount)
		dperp := r * abs(da) // 星の筋から横への距離（dist の下限）
		if dperp > dmax {
			continue
		}

		hr := hash21(k2 + 9.1)
		rho := RhoMin + (RhoMax-RhoMin)*hr
		rt := rho / (Z + trail) // 尾の根元の画面上の半径
		if r < rt {
			continue
		}
		rh := rho / Z // 頭の画面上の半径
		// 頭より外は丸く閉じ、尾の中は根元へ向けて暗くなる。
		dr := max(r-rh, 0.0)
		dist := length(vec2(dr, dperp))
		if dist > dmax {
			continue
		}
		t := clamp((rh-r)/max(rh-rt, 1e-5), 0.0, 1.0)
		along := (1.0 - t) * (1.0 - t)
		hc := hash21(k2 + 4.3)
		line := exp(-(dist*dist)/(wd*wd)) * (w / wd)
		glow := 0.12 * exp(-dist/(4.0*wd)) * (w / wd)

		// 奥では現れ、手前で消える（奥へ戻る瞬間を見せない）。手前ほど明るい。
		fade := (1.0 - smoothstep(0.8, 1.0, z)) * smoothstep(0.0, 0.1, z)
		bright := StarGain * fade * (0.45 + 0.55/(1.0+2.0*Z))

		col := mix(headColor, tailColor, t)
		col = mix(col, warmColor, step(0.92, hc)*0.7)
		c += col * (line + glow) * along * bright
	}

	// 中心の光（奥の星のかすみ）。拍頭で少し強まる。
	c += coreColor * exp(-r*4.0) * (CoreGlow + CoreGlowSurge*pump)
	c += bgColor

	return vec4(c, 1.0)
}
