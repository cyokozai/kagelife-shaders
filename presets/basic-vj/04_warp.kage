//kage:unit pixels

// 04_warp.kage — ワープ。星の中を手前へ飛ぶ。ビルドアップ用。
//
// 設計:
//   - 奥行きの違う星の層を LayerCount 枚重ねる。各層は画面を格子に切り、1 マスに星を 1 つ置く。
//     層は奥（暗く小さい）から手前（明るく大きい）へ進み、手前で消えたら奥に新しい星の並びで戻る。
//   - 星は進む速さに応じて、画面の中心から外向きに尾を引く。色は青白で、中心に淡い青紫の光。
//   - Beat: 進んだ距離を Time*CruiseSpeed + SurgeAmount*(e(Beat) - Beat) とする（e(b) = 1-(1-b)^3）。
//     e(b) - b は Beat=0 と 1 でどちらも 0 なので、拍の変わり目で位置が飛ばない。速さは拍頭で
//     CruiseSpeed + 2*SurgeAmount/拍の長さ まで上がり、拍の終わりに向けて落ちる（小節の頭は数えない）。
//     尾の長さと中心の光も同じ速さに合わせる。
//
// 1 画素あたりのループ: LayerCount 回（16 回）。
package main

var Time float
var Beat float
var Resolution vec2

// ---- 調整用の値 ------------------------------------------------------------

// 星の層の数（ループの回数）。
const LayerCount = 16

// 常に進む速さ（層の奥行き/秒）。
const CruiseSpeed = 0.35

// 拍頭の加速の量。拍の長さが 1/3 秒（180 BPM）でも後ろへ戻らないよう、CruiseSpeed より 3 倍 SurgeAmount が
// 小さすぎないことを保つ（いまは最も遅いとき 0.35 - 0.1/0.333 = 0.05 > 0）。
const SurgeAmount = 0.1

// 1 層の格子の細かさ（大きいほど星が多い）。
const GridScale = 9.0

// 星の大きさ（格子の 1 マスに対する割合）。
const StarSize = 0.035

// 尾の伸びの最大（星の大きさの倍数）。
const TrailStretch = 7.0

// ---------------------------------------------------------------------------

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y

	b := Beat
	e := 1.0 - (1.0-b)*(1.0-b)*(1.0-b)
	pos := Time*CruiseSpeed + SurgeAmount*(e-b)
	// 速さの目安（1 が巡航、拍頭で大きい）。e の傾きは 3(1-b)^2。
	speed := 1.0 + 3.0*(1.0-b)*(1.0-b)

	c := vec3(0.0)
	n := float(LayerCount)
	for i := 0; i < LayerCount; i++ {
		fi := float(i)
		u := fi/n - pos
		z := fract(u)          // 1 が奥、0 が手前
		id := fi + n*floor(u)  // 層が奥へ戻るたびに変わる番号
		depth := 0.03 + z*1.2  // 見かけの奥行き
		fade := (1.0 - smoothstep(0.75, 1.0, z)) * smoothstep(0.0, 0.08, z)
		q := uv * depth * GridScale
		cell := floor(q)
		h := hash21(cell + id*17.31)
		h2 := hash21(cell + id*5.13 + 3.7)
		sp := cell + 0.2 + 0.6*vec2(h, h2)
		d := q - sp
		// 中心から外向きに尾を引く（向きは星の位置から）。
		dir := normalize(sp + 1e-4)
		along := dot(d, dir)
		across := dot(d, vec2(-dir.y, dir.x))
		stretch := 1.0 + TrailStretch*(speed-1.0)/3.0*(1.0-z)
		// 尾（中心側, along < 0）は伸ばし、進む向きの先は短く詰める。
		if along < 0.0 {
			along = along / stretch
		} else {
			along *= 2.0
		}
		dd := length(vec2(along, across))
		s := StarSize * (0.6 + 0.8*hash21(cell+id))
		star := 1.0 - smoothstep(0.0, s, dd) + 0.15*exp(-dd/s)
		tint := mix(vec3(0.6, 0.75, 1.0), vec3(1.0, 0.95, 0.9), h)
		c += tint * star * fade * (1.3 - z)
	}

	// 中心の淡い光。
	r := length(uv)
	glow := exp(-r*3.5) * (0.06 + 0.04*(speed-1.0)/3.0)
	c += vec3(0.35, 0.3, 0.9) * glow
	c += vec3(0.0, 0.005, 0.02)

	return vec4(c, 1.0)
}
