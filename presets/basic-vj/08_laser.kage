//kage:unit pixels

// 08_laser.kage — レーザー。下から扇形に開くビームが煙の中を振れる。ピーク用。
//
// 設計:
//   - 画面の下端のすぐ下に EmitterCount 台の発光点を並べ、各台から BeamsPerEmitter 本のビームを扇形に出す。
//     扇の向きは台ごとに位相のずれた正弦で左右に振れる（隣どうしで逆向きに振れて、ビームが交差する）。
//   - 色は台ごとに緑と青紫を交互に。芯が明るいところほど白く飛ぶ。ビームは細い芯と広いにじみで描き、
//     芯にもにじみにも煙（2 段の値ノイズ）で濃淡を付けて、煙を切り裂く見え方にする。地はほぼ黒の煙。
//   - Beat:
//       1. 拍頭で扇が開き（隣のビームとの角度 SpreadBase + SpreadKick*env）、拍の終わりに閉じる。
//       2. 拍頭で全台が光る（BeamBase + BeamFlash*env, env = exp(-FlashDecay*Beat)）。
//       3. その上に小さな連鎖を重ねる。内側の 2 台は拍頭、外側の台ほど遅れて（端の台で約 ChaseLag 拍）
//          ChaseFlash だけ光り足す（中央から外へ広がる）。連鎖を主にすると拍頭ではまだ外側が光っておらず、
//          明るさの山が拍頭の後ろへずれた（初版で確かめた）ので、主の光は全台同時にしてある。
//       4. 下端の光だまりも同じ強さで脈打つ。
//     光るのは細いビームなので、画面全体の平均輝度の振れは小さい。明滅は 1 拍に 1 回（Beat の位相だけで決まり、
//     Random は使わない）。
//
// 1 画素あたりのループ: 外側 EmitterCount 回、内側の合計 EmitterCount × BeamsPerEmitter 回（8 × 3 = 24 回）。
// 三角関数は台ごとに 2 組だけ（扇のビームは回転の掛け算で並べる）。
package main

var Time float
var Beat float
var Resolution vec2

// ---- 調整用の値 ------------------------------------------------------------

// 発光点の数と、1 台あたりのビームの数（掛けたものが内側のループの回数）。
const EmitterCount = 8
const BeamsPerEmitter = 3

// 発光点を並べる幅（画面の幅に対する割合）。
const EmitterSpan = 0.84

// 扇の広がり（隣のビームとの角度, ラジアン）の常時の値と拍頭の増分。
const SpreadBase = 0.09
const SpreadKick = 0.17

// 左右の振れの大きさ（ラジアン）と速さ（ラジアン毎秒）。
const SweepAmount = 0.5
const SweepSpeed = 0.75

// ビームの芯の太さとにじみの幅（画面の高さに対する割合）。
const CoreWidth = 0.0025
const HazeWidth = 0.03

// にじみの強さ。
const HazeGain = 0.2

// ビームが上へ行くほど弱まる速さ（画面の高さ 1 あたり）。
const BeamFalloff = 0.65

// ビームの明るさの常時の値と拍頭の増分、引く速さ（拍あたり）。
const BeamBase = 0.45
const BeamFlash = 0.7
const FlashDecay = 5.0

// 連鎖の光り足しの強さと、内側の台から端の台までの遅れ（拍）。
const ChaseFlash = 0.35
const ChaseLag = 0.12

// 芯が白く飛び始める明るさ。
const WhiteHot = 0.6

// ---------------------------------------------------------------------------

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

func noise2(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3.0 - 2.0*f)
	a := hash21(i)
	b := hash21(i + vec2(1.0, 0.0))
	c := hash21(i + vec2(0.0, 1.0))
	d := hash21(i + vec2(1.0, 1.0))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

// rot は v を角 (cs.x = cos, cs.y = sin) だけ反時計回りに回す。
func rot(v vec2, cs vec2) vec2 {
	return vec2(v.x*cs.x-v.y*cs.y, v.x*cs.y+v.y*cs.x)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// 画面の中心を原点、高さを 1、上を +y にした座標。
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y
	aspect := Resolution.x / Resolution.y

	// 扇の開き。拍頭で最大、拍の中で閉じていく。
	beat := fract(Beat)
	env := exp(-FlashDecay * beat)
	spread := SpreadBase + SpreadKick*env
	turn := vec2(cos(spread), sin(spread))
	half := 0.5 * float(BeamsPerEmitter-1) * spread

	// 煙（ゆっくり流れる 2 段の値ノイズ, 0.35〜1.25 程度）。
	smoke := 0.55*noise2(uv*3.0+vec2(Time*0.08, -Time*0.05)) + 0.45*noise2(uv*7.0-vec2(0.0, Time*0.15))
	smoke = 0.35 + 0.9*smoke

	c := vec3(0.0)
	ne := float(EmitterCount)
	for i := 0; i < EmitterCount; i++ {
		fi := float(i)
		side := fi/(ne-1.0) - 0.5
		o := vec2(side*aspect*EmitterSpan, -0.52)
		odd := mod(fi, 2.0)
		sgn := 1.0 - 2.0*odd

		// 中央から外への連鎖。拍頭からの経過を台ごとに遅らせ（内側の 2 台は遅れ 0）、負なら前の拍の尾として扱う。
		local := beat - ChaseLag*max(abs(side)*2.0-1.0/(ne-1.0), 0.0)
		local += 1.0 - step(0.0, local)
		gain := BeamBase + BeamFlash*env + ChaseFlash*exp(-FlashDecay*local)

		col := mix(vec3(0.1, 1.0, 0.3), vec3(0.5, 0.25, 1.0), odd)

		// 扇の端のビームの向き。中央のビームから -half だけ回したところから始める。
		base := 1.5708 + sgn*SweepAmount*sin(Time*SweepSpeed+fi*0.7) - half
		dir := vec2(cos(base), sin(base))
		v := uv - o

		acc := 0.0
		for j := 0; j < BeamsPerEmitter; j++ {
			t := dot(v, dir)
			if t > 0.0 {
				perp := abs(v.x*dir.y - v.y*dir.x)
				core := exp(-perp * perp / (CoreWidth * CoreWidth))
				haze := exp(-perp/HazeWidth) * HazeGain * smoke * smoke
				acc += (core*(0.55+0.45*smoke) + haze) * exp(-t*BeamFalloff)
			}
			dir = rot(dir, turn)
		}
		acc *= gain
		// 明るい芯ほど白く飛ばす。
		c += col*acc + vec3(1.0)*max(acc-WhiteHot, 0.0)*0.6

		// 発光点の光だまり（同じ包絡で脈打つ）。
		c += col * 0.06 * gain * exp(-length(v)*10.0)
	}

	// 地: 暗い青紫の煙。
	c += vec3(0.008, 0.006, 0.018) * smoke

	return vec4(c, 1.0)
}
