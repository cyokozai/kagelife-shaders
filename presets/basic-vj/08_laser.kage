//kage:unit pixels

// 08_laser.kage - Lasers. Fans of beams from below sweep through smoke. For peaks.
//
// Design:
//   - EmitterCount emitters sit just below the bottom edge; each fires BeamsPerEmitter beams in a fan.
//     Fans sweep left/right on phase-shifted sines (neighbors sweep opposite ways, so beams cross).
//   - Colors alternate green and blue-violet per emitter; bright cores clip toward white. Beams are a thin core
//     plus a wide haze, both modulated by smoke (two octaves of value noise) so they look like they cut through it.
//     Background is near-black smoke.
//   - Beat:
//       1. Fans open at the downbeat (angle between beams SpreadBase + SpreadKick*env) and close by the end.
//       2. All emitters flash at the downbeat (BeamBase + BeamFlash*env, env = exp(-FlashDecay*Beat)).
//       3. A small chase on top: the inner 2 emitters at the downbeat, outer ones later (edge ~ChaseLag beats),
//          each adding ChaseFlash (spreads center -> out). With the chase as the main flash, the outer emitters
//          were still dark at the downbeat and the brightness peak lagged behind it (checked in the first version),
//          so the main flash is simultaneous on all emitters.
//       4. The glow pool at the bottom pulses with the same strength.
//     Only thin beams glow, so the full-screen average brightness swing is small. One flash per beat
//     (depends only on the Beat phase; Random is not used).
//
// Per-pixel loops: outer EmitterCount, inner total EmitterCount x BeamsPerEmitter (8 x 3 = 24).
// Only 2 trig pairs per emitter (fan beams are stepped by a rotation multiply).
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Number of emitters and beams per emitter (product = inner loop count).
const EmitterCount = 8
const BeamsPerEmitter = 3

// Emitter row width (fraction of screen width).
const EmitterSpan = 0.84

// Fan spread (angle between adjacent beams, rad): constant and downbeat boost.
const SpreadBase = 0.09
const SpreadKick = 0.17

// Sweep amplitude (rad) and speed (rad/s).
const SweepAmount = 0.5
const SweepSpeed = 0.75

// Beam core width and haze width (fraction of screen height).
const CoreWidth = 0.0025
const HazeWidth = 0.03

// Haze strength.
const HazeGain = 0.2

// Beam falloff going up (per screen height).
const BeamFalloff = 0.65

// Beam brightness: constant, downbeat boost, decay rate (per beat).
const BeamBase = 0.45
const BeamFlash = 0.7
const FlashDecay = 5.0

// Chase flash strength and delay from inner to edge emitters (beats).
const ChaseFlash = 0.35
const ChaseLag = 0.12

// Brightness where cores start clipping to white.
const WhiteHot = 0.6

// ---------------------------------------------------------------------------

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

func noise2(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3.0 - 2.0*f)
	a := hash21(i)
	b := hash21(i + vec2(1.0, 0.0))
	c := hash21(i + vec2(0.0, 1.0))
	d := hash21(i + vec2(1.0, 1.0))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

// rot rotates v counterclockwise by the angle (cs.x = cos, cs.y = sin).
func rot(v vec2, cs vec2) vec2 {
	return vec2(v.x*cs.x-v.y*cs.y, v.x*cs.y+v.y*cs.x)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// Centered coordinates, height = 1, up = +y.
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y
	aspect := Resolution.x / Resolution.y

	// Fan opening. Max at the downbeat, closing within the beat.
	beat := fract(Beat)
	env := exp(-FlashDecay * beat)
	spread := SpreadBase + SpreadKick*env
	turn := vec2(cos(spread), sin(spread))
	half := 0.5 * float(BeamsPerEmitter-1) * spread

	// Smoke (slow two-octave value noise, ~0.35..1.25).
	smoke := 0.55*noise2(uv*3.0+vec2(Time*0.08, -Time*0.05)) + 0.45*noise2(uv*7.0-vec2(0.0, Time*0.15))
	smoke = 0.35 + 0.9*smoke

	c := vec3(0.0)
	ne := float(EmitterCount)
	for i := 0; i < EmitterCount; i++ {
		fi := float(i)
		side := fi/(ne-1.0) - 0.5
		o := vec2(side*aspect*EmitterSpan, -0.52)
		odd := mod(fi, 2.0)
		sgn := 1.0 - 2.0*odd

		// Center-out chase. Delay time since the downbeat per emitter (inner 2: no delay); negative = previous beat's tail.
		local := beat - ChaseLag*max(abs(side)*2.0-1.0/(ne-1.0), 0.0)
		local += 1.0 - step(0.0, local)
		gain := BeamBase + BeamFlash*env + ChaseFlash*exp(-FlashDecay*local)

		col := mix(vec3(0.1, 1.0, 0.3), vec3(0.5, 0.25, 1.0), odd)

		// Direction of the fan's edge beam: start at -half from the center beam.
		base := 1.5708 + sgn*SweepAmount*sin(Time*SweepSpeed+fi*0.7) - half
		dir := vec2(cos(base), sin(base))
		v := uv - o

		acc := 0.0
		for j := 0; j < BeamsPerEmitter; j++ {
			t := dot(v, dir)
			if t > 0.0 {
				perp := abs(v.x*dir.y - v.y*dir.x)
				core := exp(-perp * perp / (CoreWidth * CoreWidth))
				haze := exp(-perp/HazeWidth) * HazeGain * smoke * smoke
				acc += (core*(0.55+0.45*smoke) + haze) * exp(-t*BeamFalloff)
			}
			dir = rot(dir, turn)
		}
		acc *= gain
		// Brighter cores clip toward white.
		c += col*acc + vec3(1.0)*max(acc-WhiteHot, 0.0)*0.6

		// Emitter glow pool (pulses with the same envelope).
		c += col * 0.06 * gain * exp(-length(v)*10.0)
	}

	// Background: dark blue-violet smoke.
	c += vec3(0.008, 0.006, 0.018) * smoke

	return vec4(c, 1.0)
}
