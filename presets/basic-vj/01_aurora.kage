//kage:unit pixels

// 01_aurora.kage — オーロラ。イントロ・ブレイク用のいちばん静かな絵。
//
// 設計:
//   - 夜空（紺から黒への縦のグラデーションと瞬く星）に、光のカーテンを CurtainCount 枚重ねる。
//     カーテンは下端がくっきりして上へ長く薄れる形で、横に波打ちながらゆっくり流れる。縦の筋は 1 次元のノイズで作る。
//   - 色は下が緑、上が青緑から紫。手前の下に山の影を置いて、地平を決める。
//   - 動きはほぼ Time だけ。Beat は拍頭でカーテンの明るさを BreathAmount だけ上げる「呼吸」にしか使わない。
//
// 1 画素あたりのループ: CurtainCount 回（4 回）。
package main

var Time float
var Beat float
var Resolution vec2

// ---- 調整用の値 ------------------------------------------------------------

// カーテンの枚数（ループの回数）。
const CurtainCount = 4

// カーテンが横に流れる速さ（画面の高さ/秒）。
const DriftSpeed = 0.035

// カーテンの下端の高さの基準（画面の中心が 0、上が正。画面の高さを 1 とする）。
const CurtainBase = -0.08

// カーテンの下端が上下に揺れる幅。
const CurtainWave = 0.12

// カーテンが上へ薄れる速さ（大きいほど背が低い）。
const FadeUp = 3.2

// カーテンの下端のくっきり具合（大きいほど鋭い）。
const EdgeSharp = 38.0

// カーテン 1 枚の明るさ。
const CurtainGain = 0.42

// 拍頭の呼吸の強さ（明るさの増分の割合）。小さく保つ。
const BreathAmount = 0.08

// 呼吸が拍頭から引く速さ。
const BreathDecay = 3.0

// 星の多さ（画素の格子のうち星になる割合）。
const StarDensity = 0.0025

// ---------------------------------------------------------------------------

func hash11(n float) float {
	return fract(sin(n*127.1+3.3) * 43758.5453)
}

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

// noise1 は 1 次元のなめらかなノイズ（0〜1）。
func noise1(x float) float {
	i := floor(x)
	f := fract(x)
	u := f * f * (3.0 - 2.0*f)
	return mix(hash11(i), hash11(i+1.0), u)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y

	// 夜空。
	sky := mix(vec3(0.012, 0.02, 0.06), vec3(0.0, 0.005, 0.02), clamp(uv.y+0.5, 0.0, 1.0))

	// 星（2 画素の格子ごとに 1 つ判定し、ゆっくり瞬く）。
	cell := floor(dstPos.xy / 2.0)
	h := hash21(cell)
	if h < StarDensity {
		tw := 0.6 + 0.4*sin(Time*(1.0+h*900.0)+h*6283.0)
		sky += vec3(0.8, 0.85, 1.0) * tw * 0.7
	}

	breath := 1.0 + BreathAmount*exp(-BreathDecay*Beat)

	// カーテン。
	glow := vec3(0.0)
	for i := 0; i < CurtainCount; i++ {
		fi := float(i)
		x := uv.x*(0.8+0.25*fi) + Time*DriftSpeed*(1.0+0.6*fi) + fi*7.3
		base := CurtainBase + 0.07*fi + CurtainWave*(noise1(x*1.4+Time*0.07)-0.5) + 0.05*sin(x*2.1+Time*0.2)
		d := uv.y - base
		shape := 0.0
		if d > 0.0 {
			shape = exp(-d * FadeUp * (1.0 + 0.3*fi))
		} else {
			shape = exp(d * EdgeSharp)
		}
		rays := 0.35 + 0.65*noise1(x*26.0+Time*0.25+fi*13.0)
		low := vec3(0.15, 1.0, 0.45)
		mid := vec3(0.1, 0.75, 0.85)
		top := vec3(0.65, 0.25, 0.95)
		t := clamp(d*3.0, 0.0, 1.0)
		col := mix(mix(low, mid, smoothstep(0.0, 0.5, t)), top, smoothstep(0.4, 1.0, t))
		glow += col * shape * rays * CurtainGain / (1.0 + 0.4*fi)
	}
	c := sky + glow*breath

	// 手前の山の影。
	ridge := -0.36 + 0.06*noise1(uv.x*3.0+11.0) + 0.025*noise1(uv.x*11.0+3.0)
	c = mix(c, vec3(0.004, 0.006, 0.012), 1.0-smoothstep(ridge-0.003, ridge+0.003, uv.y))

	return vec4(c, 1.0)
}
