//kage:unit pixels

// 01_aurora.kage - Aurora. The calmest look, for intros and breaks.
//
// Design:
//   - Night sky (navy-to-black vertical gradient, twinkling stars) with CurtainCount light curtains.
//     Each curtain has a sharp lower edge, fades upward, waves sideways and drifts slowly.
//     Vertical rays come from 1D noise.
//   - Horizontal noise makes dense patches and gaps along each curtain.
//   - Color: green at the bottom, teal to purple at the top. The top color drifts between purple and blue
//     with period PaletteDrift (s). A mountain silhouette sets the horizon, with faint green airglow above it.
//   - Brightness is compressed with 1 - exp(-x) so overlapping curtains do not clip to white.
//   - Motion is driven almost only by Time. Beat drives only a "breath":
//     (0.5+0.5cos(2*pi*Beat))^BreathShape, max at the downbeat, 0 mid-beat, continuous across beats
//     (no brightness step). The breath adds BreathAmount brightness and BreathReach height.
//     No full-screen flashing.
//   - Hashes use fract, not sin, so patterns stay stable after hours of Time.
//
// Per-pixel loops: CurtainCount (4). No nested loops.
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Number of curtains (loop count).
const CurtainCount = 4

// Horizontal drift speed (screen heights/s).
const DriftSpeed = 0.035

// Base height of the curtain's lower edge (screen center = 0, up = +, screen height = 1).
const CurtainBase = -0.10

// Vertical sway of the lower edge.
const CurtainWave = 0.14

// Upward fade rate (larger = shorter curtains).
const FadeUp = 2.6

// Sharpness of the lower edge (larger = sharper).
const EdgeSharp = 40.0

// Brightness of one curtain.
const CurtainGain = 0.55

// Patch scale (larger = more gaps).
const PatchScale = 0.9

// Brightness gain of the downbeat breath. Keep small (large values read as flashing).
const BreathAmount = 0.10

// How much the breath stretches curtains upward (fraction FadeUp is relaxed).
const BreathReach = 0.12

// Breath peak sharpness (larger = closer to the downbeat; 1 = plain cos).
const BreathShape = 2.0

// Period of the top color's purple/blue drift (s).
const PaletteDrift = 47.0

// Tone-mapping strength (larger = brighter, saturates sooner).
const Exposure = 1.4

// Star density (fraction of grid cells that hold a star).
const StarDensity = 0.0025

// Airglow brightness above the ridge.
const AirGlow = 0.05

// Base height of the ridge.
const RidgeBase = -0.36

// ---------------------------------------------------------------------------

const Pi = 3.14159265

// hash11 is a 1D hash without sin (0..1).
func hash11(p float) float {
	p = fract(p * 0.1031)
	p *= p + 33.33
	p *= p + p
	return fract(p)
}

func hash21(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

// noise1 is smooth 1D value noise (0..1).
func noise1(x float) float {
	i := floor(x)
	f := fract(x)
	u := f * f * (3.0 - 2.0*f)
	return mix(hash11(i), hash11(i+1.0), u)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y

	// Night sky.
	sky := mix(vec3(0.012, 0.02, 0.06), vec3(0.0, 0.005, 0.02), clamp(uv.y+0.5, 0.0, 1.0))

	// Stars (one test per 2-pixel cell, slow twinkle).
	cell := floor(dstPos.xy / 2.0)
	h := hash21(cell)
	if h < StarDensity {
		hs := h / StarDensity
		tw := 0.6 + 0.4*sin(Time*(0.8+hs*2.0)+hs*6.283)
		sky += vec3(0.8, 0.85, 1.0) * tw * 0.6
	}

	// Breath (1 at downbeat, 0 mid-beat, continuous across beats).
	bp := pow(0.5+0.5*cos(2.0*Pi*Beat), BreathShape)
	gain := 1.0 + BreathAmount*bp
	reach := 1.0 - BreathReach*bp

	// Slow drift of the top color (purple <-> blue).
	pd := 0.5 + 0.5*sin(2.0*Pi*Time/PaletteDrift)
	low := vec3(0.15, 1.0, 0.45)
	mid := vec3(0.08, 0.75, 0.85)
	top := mix(vec3(0.62, 0.22, 0.95), vec3(0.25, 0.35, 1.0), pd)

	// Curtains.
	glow := vec3(0.0)
	for i := 0; i < CurtainCount; i++ {
		fi := float(i)
		x := uv.x*(0.8+0.25*fi) + Time*DriftSpeed*(1.0+0.6*fi) + fi*7.3
		base := CurtainBase + 0.07*fi + CurtainWave*(noise1(x*1.4+Time*0.07)-0.5) + 0.05*sin(x*2.1+Time*0.2)
		d := uv.y - base
		shape := 0.0
		if d > 0.0 {
			shape = exp(-d * FadeUp * (1.0 + 0.3*fi) * reach)
		} else {
			shape = exp(d * EdgeSharp)
		}
		rays := 0.35 + 0.65*noise1(x*26.0+Time*0.25+fi*13.0)
		patch := smoothstep(0.2, 0.7, noise1(x*PatchScale+fi*5.1+Time*0.03))
		t := clamp(d*3.0, 0.0, 1.0)
		col := mix(mix(low, mid, smoothstep(0.0, 0.5, t)), top, smoothstep(0.4, 1.0, t))
		glow += col * shape * rays * (0.25 + 0.75*patch) * CurtainGain / (1.0 + 0.4*fi)
	}
	glow = vec3(1.0) - exp(-glow*gain*Exposure)

	// Airglow above the ridge.
	air := vec3(0.1, 0.6, 0.35) * AirGlow * exp(-max(uv.y-RidgeBase, 0.0)*6.0)
	c := sky + air + glow

	// Mountain silhouette in front.
	ridge := RidgeBase + 0.06*noise1(uv.x*3.0+11.0) + 0.025*noise1(uv.x*11.0+3.0)
	c = mix(c, vec3(0.004, 0.006, 0.012), 1.0-smoothstep(ridge-0.003, ridge+0.003, uv.y))

	return vec4(c, 1.0)
}
