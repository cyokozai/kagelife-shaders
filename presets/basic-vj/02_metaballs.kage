//kage:unit pixels

// 02_metaballs.kage - Metaballs. For mid/low-end grooves.
//
// Design:
//   - BallCount molten blobs on a deep ink-teal background. Each drifts on its own Lissajous curve;
//     nearby blobs merge (inside = where the summed field exceeds 1).
//   - Each blob has a color (magenta, vermilion, amber, hot pink), mixed by field weight, so colors
//     blend where blobs merge. The core shifts toward near-white yellow (hot lava-lamp core).
//   - Normals come from the field gradient; light from the upper left adds shading and specular (wet look).
//   - Beat (phase within one beat) drives three things:
//       Bounce: height = BounceHeight * sin(pi*Beat). Lowest (landing) at the downbeat, highest mid-beat.
//               No position jump when Beat wraps from 1 to 0.
//       Squash: at the downbeat, wider and shorter (SquashAmount, area ~kept). Recovers by exp(-SquashDecay*Beat).
//       Swell + rim: at the downbeat, radius x (1 + SwellAmount) and a stronger rim. Decays by exp(-SwellDecay*Beat).
//     The only full-screen brightening is swell + rim, once per beat at the downbeat.
//     Random is not used (no per-frame flicker).
//
// Per-pixel loops: BallCount (6). Single loop.
package main

var Time float
var Beat float
var Resolution vec2

// ---- Tuning ----------------------------------------------------------------

// Number of blobs (loop count).
const BallCount = 6

// Base blob radius (fraction of screen height).
const BallRadius = 0.12

// Downbeat swell (fractional radius increase). Raising it increases the per-beat brightness swing.
const SwellAmount = 0.2

// Decay rate of swell and rim.
const SwellDecay = 5.0

// Downbeat squash (fractional horizontal stretch).
const SquashAmount = 0.22

// Squash recovery rate. Slightly faster than swell gives a bouncy feel.
const SquashDecay = 7.0

// Bounce height (fraction of screen height). Max mid-beat.
const BounceHeight = 0.045

// Drift speed.
const DriftSpeed = 0.33

// Shading strength. Larger = rounder, more raised edges.
const NormalScale = 0.045

// Rim light: constant level and downbeat boost.
const RimBase = 0.25
const RimBeat = 0.55

// ---------------------------------------------------------------------------

func hash11(n float) float {
	return fract(sin(n*127.1+3.3) * 43758.5453)
}

// ballColor returns a blob color. k is a 0..1 hash. Order: magenta -> vermilion -> amber -> hot pink.
func ballColor(k float) vec3 {
	if k < 0.25 {
		return vec3(0.9, 0.08, 0.5)
	}
	if k < 0.5 {
		return vec3(1.0, 0.3, 0.1)
	}
	if k < 0.75 {
		return vec3(1.0, 0.62, 0.12)
	}
	return vec3(1.0, 0.25, 0.6)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := (dstPos.xy - 0.5*Resolution) / Resolution.y
	uv.y = -uv.y // up is +.
	aspect := Resolution.x / Resolution.y

	swell := exp(-SwellDecay * Beat)
	sq := SquashAmount * exp(-SquashDecay*Beat)
	sx := 1.0 / (1.0 + sq) // wider (shrink measured x distance).
	sy := 1.0 + sq         // shorter.
	hop := sin(3.14159265 * Beat)
	r := BallRadius * (1.0 + SwellAmount*swell)

	field := 0.0
	grad := vec2(0.0)
	tint := vec3(0.0)
	for i := 0; i < BallCount; i++ {
		fi := float(i)
		fx := 0.3 + 0.5*hash11(fi*3.1)
		fy := 0.25 + 0.5*hash11(fi*5.7+1.0)
		ph := hash11(fi*9.2+2.0) * 6.2832
		c := vec2(0.38*aspect*sin(Time*DriftSpeed*fx+ph), 0.27*cos(Time*DriftSpeed*fy+ph*1.7))
		// Vary bounce height slightly per blob.
		c.y += BounceHeight * hop * (0.6 + 0.4*hash11(fi+7.0))
		ri := r * (0.75 + 0.5*hash11(fi*2.3+4.0))
		d := uv - c
		q := d.x*d.x*sx*sx + d.y*d.y*sy*sy + 1e-5
		f := ri * ri / q
		field += f
		// Gradient of f: -2 f/q * (sx^2 d.x, sy^2 d.y)
		grad += -2.0 * f / q * vec2(sx*sx*d.x, sy*sy*d.y)
		tint += f * ballColor(hash11(fi*4.7+11.0))
	}

	// Background: ink teal, slightly brighter at the top, darker toward the center.
	bg := mix(vec3(0.0, 0.02, 0.03), vec3(0.01, 0.07, 0.09), clamp(uv.y+0.5, 0.0, 1.0))
	bg *= 1.0 - 0.35*clamp(length(uv*vec2(0.8, 1.0)), 0.0, 1.0)
	// Halo around blobs (heat glow).
	halo := smoothstep(0.25, 1.0, field)
	bg += vec3(0.45, 0.08, 0.2) * 0.18 * halo

	// Body color: blob colors mixed by field weight, toward near-white yellow at the core.
	base := tint / max(field, 1e-4)
	core := clamp((field-1.0)/6.0, 0.0, 1.0)
	coreMix := smoothstep(0.3, 1.0, core)
	body := mix(base, vec3(1.0, 0.8, 0.45), coreMix)

	// Normal: treat height as h = 1 - 1/field, so grad h = grad field / field^2. Flat at the center, tilted at edges.
	// (The gradient of log(field) diverges at blob centers and left black dots, so it is not used.)
	g := grad / max(field*field, 1e-4) * NormalScale
	n := normalize(vec3(-g, 1.0))
	l := normalize(vec3(-0.5, 0.6, 1.0))
	h := normalize(l + vec3(0.0, 0.0, 1.0))
	diff := 0.45 + 0.55*max(dot(n, l), 0.0)
	spec := pow(max(dot(n, h), 0.0), 36.0)

	// Antialias the edge over one pixel (estimate per-pixel field change from the gradient).
	px := length(grad) / Resolution.y
	aa := max(px*1.5, 0.01)
	inside := smoothstep(1.0-aa, 1.0+aa, field)

	// The core is self-lit, so weaken shading there (avoid muddy shadowed color).
	shaded := body*mix(diff, 1.1, coreMix) + vec3(1.0, 0.95, 0.9)*spec*0.6
	col := mix(bg, shaded, inside)

	// Rim light (stronger at the downbeat).
	rim := exp(-abs(field-1.0) * 10.0)
	col += mix(base, vec3(1.0, 0.7, 0.9), 0.5) * rim * (RimBase + RimBeat*swell)

	return vec4(col, 1.0)
}
